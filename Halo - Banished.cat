 typeId="points" value="90.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="0ec2-626e-e876-42d1" name="Armoury" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="3ac8-773f-42d6-1da7" name="Scrap Armour Screens" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. Flat 10 pts.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3e1c-040a-4bca-198f"/></constraints><infoLinks><infoLink id="7bc0-4149-644c-c648" name="Scrap Armour Screens" hidden="false" targetId="d70a-2251-1bab-b175" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4d12-2b45-73a4-b798" name="Eklon'Dal Workshop Warrior Carriage" hidden="false" collective="false" import="true" type="unit"><comment>Force org slot: transport</comment><profiles><profile id="13ef-892a-f809-8c83" name="Eklon'Dal Workshop Warrior Carriage" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Car</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">7+ (Armoured Anti-Grav)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">12</characteristic></characteristics></profile><profile id="faa7-2fa7-d0df-4a90" name="Casement-mounted Forward-facing Light Anti-Tank Weapon" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">48&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">+4</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Team, Fixed, HE (1&quot;), AT Gun</characteristic></characteristics></profile></profiles><rules><rule id="36fb-2437-e877-4d47" name="Versatile" hidden="false"><description>The Light Anti-Tank Weapon can also fire as a Light Howitzer: Range 48&quot; (30–60&quot;), Shots 1, Pen HE, Team, Fixed, Howitzer, HE (2&quot;).</description></rule><rule id="fa8f-2e85-9c12-f5fe" name="Heavy Thrusters" hidden="false"><description>This vehicle only doubles its movement on roads when given a Run order.</description></rule></rules><infoLinks><infoLink id="9377-c065-63a5-fe7c" name="Reinforced Front Armour" hidden="false" targetId="2fca-b3ac-350d-0d37" type="rule"/><infoLink id="22e4-dc70-9da8-919d" name="Team" hidden="false" targetId="6f66-da7c-bbd4-6256" type="rule"/><infoLink id="dc9f-5d58-0c3e-67cb" name="Fixed" hidden="false" targetId="b59b-2104-403e-f4a6" type="rule"/><infoLink id="c399-63a7-259e-488b" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/><infoLink id="f05a-e7a1-85b9-ba8a" name="AT Gun" hidden="false" targetId="c079-b951-5547-15db" type="rule"/></infoLinks><categoryLinks><categoryLink id="78cb-752e-be72-a442" name="Armoured Cars &amp; Transports" hidden="false" targetId="9ad2-eb83-f25d-9853" primary="true"/><categoryLink id="82c3-8177-58aa-3fd5" name="Transport" hidden="false" targetId="38b8-d7c9-0d17-70cc" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="6380-7041-76a9-8ee7" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="aac1-24cd-9a47-3c1f"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7ae3-4f96-15c7-05ab"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5047-d74c-7aa0-7f98"/></constraints><selectionEntries><selectionEntry id="aac1-24cd-9a47-3c1f" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="21ea-862e-d871-ed68"/></constraints><costs><cost name="pts" typeId="points" value="135.0"/></costs></selectionEntry><selectionEntry id="916b-14a8-17a6-2350" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2746-009e-259f-d13a"/></constraints><costs><cost name="pts" typeId="points" value="162.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="9062-89a5-260d-6511" name="Armoury" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="6b84-bf2c-6adc-37fc" name="Scrap Armour Screens" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. Flat 10 pts.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e7e2-c3d5-209d-ec30"/></constraints><infoLinks><infoLink id="cec4-b708-7a6e-061a" name="Scrap Armour Screens" hidden="false" targetId="d70a-2251-1bab-b175" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="e4b7-ca6d-bde9-d056" name="Atriox" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Atriox requires at least 4 Banished Infantry units. Atriox requires a Brute Platoon Commander. Atriox requires at least one Grunt, Jackal, or Elite Infantry unit.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c3c7-db0c-eb31-7ee2"/></constraints><rules><rule id="05f0-5fc9-ac85-0a1f" name="Calculated Command" hidden="false"><description>Once per game, when a friendly Banished Infantry or Artillery unit is given a Down order as a reaction, you may use this rule. Choose one other friendly Banished Infantry or Artillery unit that currently has a Down order die assigned to it. You may remove 1 pin from it and move that Down order die to the reacting unit instead.

The reacting unit is treated as having gone Down as normal. The other unit no longer has an order die assigned and may be activated later in the turn as normal.</description></rule></rules><categoryLinks><categoryLink id="a5fd-29cf-0b71-a45a" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="b290-aa2f-9262-bb41" name="Leader: Atriox" hidden="false" targetId="674b-c71b-18fd-20c7" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="30.0"/></costs></selectionEntry><selectionEntry id="e0fb-2404-1bc9-232b" name="Colony" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Colony requires one Hunter Pack unit of 4 Hunters. Colony requires at least 2 Skitterers.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="faf1-7b39-8bc4-ff59"/></constraints><rules><rule id="f11e-e7d9-0e2a-b7d0" name="Ironclad Hunters" hidden="false"><description>Hunter Pack units improve their Carapace rule. When resolving shooting attacks that originate from more than 6&quot; away, treat those Hunter Pack units as having DV 8+ instead of DV 7+.

In addition, an army led by Colony may include up to two Hunter Pack units per army instead of the usual limit of one.</description></rule></rules><categoryLinks><categoryLink id="a039-a9e4-c638-5965" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="4da8-03e2-0543-ba30" name="Leader: Colony" hidden="false" targetId="df1f-d7b9-71cc-7656" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="50.0"/></costs></selectionEntry><selectionEntry id="9a94-d7b9-6a6f-4605" name="Jega 'Rdomnai" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Jega 'Rdomnai requires at least 3 Elite Infantry units. Jega 'Rdomnai requires an Elite Platoon Commander. Jega 'Rdomnai may include no more Brute Infantry units than Elite Infantry units. Brutes: ?, Elites: ?</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9ab5-4b01-d6f3-7bed"/></constraints><rules><rule id="46e1-f238-dc5c-4392" name="Trophy Assassins" hidden="false"><description>The Trophy Takers army rule also affects friendly Banished Elite Infantry units.

When a friendly Banished Elite Infantry unit wins a Close Quarters combat for the first time, it gains Trophy Plate Harness for the rest of the battle.</description></rule></rules><categoryLinks><categoryLink id="22ac-47f4-4169-260b" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="44f9-39e4-ff22-4225" name="Leader: Jega 'Rdomnai" hidden="false" targetId="879e-bf85-8d4b-c6f2" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="20.0"/></costs></selectionEntry><selectionEntry id="2fbc-209d-84a0-3abe" name="Decimus" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Decimus requires at least 4 Brute Infantry units. Decimus requires a Brute Platoon Commander. Decimus may not include more Elite Infantry units than Brute Infantry units. Elites: ?, Brutes: ?</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="eac5-67e9-227a-3fe2"/></constraints><rules><rule id="f6cb-1e5a-c84f-e756" name="Unrelenting Advance" hidden="false"><description>Once per game, when a friendly Brute Infantry unit is given a Run order that is not an assault, you may use this rule.

After completing its movement, that unit may fire its weapons as if it had advanced.</description></rule></rules><categoryLinks><categoryLink id="3e73-2d54-849c-b4f1" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="6a11-7cef-a350-9514" name="Leader: Decimus" hidden="false" targetId="70f5-2a4f-6f47-88c1" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="20.0"/></costs></selectionEntry></selectionEntries></catalogue>
