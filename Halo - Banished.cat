><comment>Designate this vehicle as a Command Vehicle (+10 pts). Not allowed on a Juggernaut Key Mind.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e114-0e45-6a2a-6975"/></constraints><infoLinks><infoLink id="4b3a-82d3-0ea2-6148" name="Command Vehicle" hidden="false" targetId="6768-ad5e-d28b-8396" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="e4d9-7a84-12a1-27ae" name="Armoury" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="2eb4-c8d5-44ac-3a49" name="Scrap Armour Screens" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. Flat 10 pts.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4474-3005-d525-6b32"/></constraints><infoLinks><infoLink id="d9f7-8239-bc82-5991" name="Scrap Armour Screens" hidden="false" targetId="d70a-2251-1bab-b175" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="0478-6f1a-f0d9-7763" name="Methane Wagon" hidden="false" collective="false" import="true" type="unit"><profiles><profile id="8549-3bba-3a12-9a93" name="Methane Wagon" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Car</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">7+ (Light Anti-Grav Vehicle)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile><profile id="4106-34b0-24bb-2639" name="Forward-facing Hull-mounted Methane Keg Launcher" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">12–36&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">–</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Indirect Fire</characteristic></characteristics></profile></profiles><rules><rule id="c396-96c0-463a-4ac6" name="Infusion-Enriched Methane" hidden="false"><description>All Grunt Infantry and Artillery models within 6&quot; of this vehicle count as being within 6&quot; of a Medic. In addition, Grunt Infantry units that are issued an order while within 6&quot; of this vehicle count as having the Berserker special rule for the duration of that activation. All Infantry and Artillery units that are not Grunts and are issued an order while within 6&quot; of this vehicle count as having the Shirkers special rule for the duration of that activation.</description></rule><rule id="c414-4389-fa62-291f" name="Methane Keg Launcher" hidden="false"><description>Range 12–36&quot;, Indirect Fire. This weapon does not inflict damage. If the shot hits, place a 3&quot; diameter Methane Cloud marker centred on the target point. The marker follows the normal rules for Smoke. Units within 6&quot; are affected by Infusion-Enriched Methane exactly as if they were within 6&quot; of the Methane Wagon.</description></rule><rule id="dd89-9c7c-6254-646b" name="Volatile Methane" hidden="false"><description>If this vehicle is destroyed as the result of a shooting attack or assault, every unit within 6&quot; of the vehicle suffers one HE (1&quot;) hit.</description></rule></rules><infoLinks><infoLink id="ff9f-aab1-3ead-2a5a" name="Open-topped" hidden="false" targetId="9f53-15e2-e2eb-9ee8" type="rule"/><infoLink id="db89-8860-06a8-fac0" name="Slower" hidden="false" targetId="34