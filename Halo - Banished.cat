&quot;) hits or make the Damage roll with +7 Penetration instead.</description></rule></rules><infoLinks><infoLink id="ef36-513d-b9d3-f668" name="Tank Hunters" hidden="false" targetId="94e0-aa25-ea6d-2b93" type="rule"/><infoLink id="bb86-6d98-fa58-10bc" name="Infiltrator" hidden="false" targetId="c4aa-6536-5471-bd48" type="rule"/><infoLink id="4e06-507a-d7e1-99fc" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/></infoLinks><categoryLinks><categoryLink id="98d9-6628-325c-3edb" name="Teams &amp; Artillery" hidden="false" targetId="a565-b680-54d0-c12b" primary="true"/><categoryLink id="0d5e-6521-2d3a-4049" name="Transport Allowance Unit" hidden="false" targetId="c868-ee48-0704-5a98" primary="false"/><categoryLink id="3a84-3ff2-ef22-5e21" name="Infantry or Team" hidden="false" targetId="cd99-8a64-279e-3014" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="3d58-8e4b-10a8-10a6" name="Models" hidden="false" collective="false" import="true" type="model"><comment>Unit size 1–2 models. Starts at 1; add models up to 2.</comment><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c6d1-6988-0aff-ed5d"/><constraint type="max" value="2" field="selections" scope="parent" shared="true" id="e43a-1ce5-fd74-ac44"/></constraints><modifiers><modifier type="set" field="points" value="20"><conditions><condition type="atLeast" value="1" field="selections" scope="206f-b710-fa17-b7a6" childId="8ea9-a73d-2687-9e69" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier><modifier type="set" field="points" value="26"><conditions><condition type="atLeast" value="1" field="selections" scope="206f-b710-fa17-b7a6" childId="8c5f-22fd-c64a-116b" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><costs><cost name="pts" typeId="points" value="14.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><sel