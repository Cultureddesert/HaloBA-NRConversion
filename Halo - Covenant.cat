162-476c-a031-003b" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="bacd-d214-60f8-a08b" childId="ec1f-d590-a851-8643" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier><modifier type="decrement" field="c162-476c-a031-003b" value="2"/></modifiers><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Infantry</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">2</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">6+</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile><profile id="4990-6b78-1eb4-aee1" name="Assault Cannon" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><modifiers><modifier type="increment" field="1c44-f79c-f5d5-65a2" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="bacd-d214-60f8-a08b" childId="ec1f-d590-a851-8643" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier><modifier type="decrement" field="1c44-f79c-f5d5-65a2" value="2"/></modifiers><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">2</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">36&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">+3</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Overheat, Shaped Charge, HE (2&quot;)</characteristic></characteristics></profile></profiles><rules><rule id="83b0-ed5d-8596-8c9f" name="Carapace" hidden="false"><description>When resolving shooting attacks that originate from more than 6&quot; away, treat this unit as having DV 7+. It still receives pins from small-arms fire, but ignores any small-arms damage. Attacks from 6&quot; or less ignore this rule.</description></rule><rule id="f31e-7cb4-b325-9760" name="Bonded Fury" hidden="false"><description>If this unit takes a casualty, the remaining models in the unit gain the Berserker special rule (+1 attack per model on first round when they assault, and on failed order test it assaults closest enemy infantry unit).</description></rule><rule id="f320-2862-b12c-3803" name="Limited" hidden="false"><description>Only 1 Hunter Pack may be taken per army.</description></rule></rules><infoLinks><infoLink id="83d1-4517-9e64-96f9" name="Resilient" hidden="false" targetId="c4d8-8191-74be-01f2" type="rule"/><infoLink id="c5b7-bd5a-a345-d317" name="Tough Fighters" hidden="false" targetId="5615-e6c8-37bd-dd58" type="rule"/><infoLink id="8e4c-9b79-12f6-7078" name="Tooth and Claw" hidden="false" targetId="34ab-5e26-7b12-2ea7" type="rule"/><infoLink id="5c12-5a1b-7ddc-5b03" name="Stubborn" hidden="false" targetId="56f4-3674-15fc-d3a9" type="rule"/><infoLink id="a4a5-0a0e-6281-99a1" name="Horror" hidden="false" targetId="8d17-f961-100c-1c5d" type="rule"/><infoLink id="1143-d2f4-b4f6-1a1f" name="Large Infantry" hidden="false" targetId="a6ac-b14c-a013-638c" type="rule"/><infoLink id="3de0-e3b1-22dd-5c5a" name="Wide Formation" hidden="false" targetId="ddd5-7152-2e25-0414" type="rule"/><infoLink id="f2c3-da6a-f1f9-6bfc" name="Overheat" hidden="false" targetId="7215-1a4f-dbf9-0053" type="rule"/><infoLink id="4f66-4c58-3225-adf9" name="Shaped Charge" hidden="false" targetId="9ede-218d-bbb4-33a1" type="rule"/><infoLink id="ec9d-b848-cefc-8d64" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/></infoLinks><categoryLinks><categoryLink id="efa6-6920-2668-c6a1" name="Infantry" hidden="false" targetId="df70-8f8e-7691-78d3" primary="true"/><categoryLink id="46dc-7af0-4585-8aa9" name="Rifle Platoon Infantry" hidden="false" targetId="5849-8392-0f7a-fe48" primary="false"/><categoryLink id="c77e-f1c7-a696-201c" name="Transport Allowance Unit" hidden="false" targetId="c868-ee48-0704-