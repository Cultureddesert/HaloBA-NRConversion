Entry id="ca52-939a-84ee-7223" name="Enforcer Sentinel" hidden="false" collective="false" import="true" type="unit"><profiles><profile id="f302-6933-7254-a4c4" name="Enforcer Sentinel" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Aircraft</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">7+ (Medium Aircraft)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile><profile id="20e6-d776-757a-1c8f" name="Hull-mounted Forward-facing Paired Heavy Machine Gun" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">48&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">6</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">+1</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Team, Fixed</characteristic></characteristics></profile><profile id="9f2d-b4f0-0dfa-d09d" name="Hull-mounted Forward-facing Rocket Launcher" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">30&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">+5</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Team, Shaped Charge, Tracking, HE (1&quot;)</characteristic></characteristics></profile></profiles><rules><rule id="1294-1c51-2612-14d3" name="Hard-Light Pavise" hidden="false"><description>Shooting attacks that hit the Front arc cause pin markers only if they penetrate (i.e., the damage roll equals or exceeds DV); otherwise ignore pins.</description></rule><rule id="8bbc-4c6d-cf82-b716" name="Gravitic Grapplers" hidden="false"><description>After Advancing across one or more enemy non-Aircraft vehicles, this aircraft may forgo all shooting to target one of them. Both vehicles roll D6 + their own DV. If the Enforcer's total is higher, the target rolls for Full Damage; if tied, it rolls for Superficial Damage. If lower, the Grapplers are destroyed, the Enforcer suffers D3 Pins, and this ability cannot be used again.</description></rule></rules><infoLinks><infoLink id="f652-3307-5a95-39d0" name="Flak" hidden="false" targetId="6402-5993-c584-f7e1" type="rule"/><infoLink id="2441-0223-6bba-3a8c" name="Open-topped" hidden="false" targetId="9f53-15e2-e2eb-9ee8" type="rule"/><infoLink id="6185-eefe-9e80-47d4" name="Team" hidden="false" targetId="6f66-da7c-bbd4-6256" type="rule"/><infoLink id="076f-cbb1-dcf5-db57" name="Fixed" hidden="false" targetId="b59b-2104-403e-f4a6" type="rule"/><infoLink id="ee24-fc36-d1d5-a6b6" name="Shaped Charge" hidden="false" targetId="9ede-218d-bbb4-33a1" type="rule"/><infoLink id="f47f-68eb-341c-c855" name="Tracking" hidden="false" targetId="e20f-eab6-7692-9069" type="rule"/><infoLink id="41c2-beb7-b1dc-1a31" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/></infoLinks><categoryLinks><categoryLink id="af00-20e0-97c3-7b4c" name="Aircraft" hidden="false" targetId="9cd4-4d03-18e5-5c89" primary="true"/><categoryLink id="22aa-e18c-c44d-4436" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="2362-40df-ca5e-c271" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="133c-5b8c-7c3b-d5c1"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b063-a6c6-4dc2-6c8e"/><constraint type="m