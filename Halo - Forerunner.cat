dden="false"><description>When this unit is given a successful Fire order, it may activate its gravitic beam. If it does, each other unit within 6&quot; of this unit receives D3 pins.</description></rule></rules><infoLinks><infoLink id="bb6d-f0cc-596e-a2cd" name="Flak" hidden="false" targetId="6402-5993-c584-f7e1" type="rule"/><infoLink id="a3c7-deae-1632-ad4a" name="Shielded Hull" hidden="false" targetId="1bb2-189b-cc93-ac0a" type="rule"/><infoLink id="7a93-b7d7-45af-a785" name="Sustained Beam" hidden="false" targetId="9d9c-6aae-c4c4-f87f" type="rule"/><infoLink id="eb74-560a-c8a3-0e71" name="Team" hidden="false" targetId="6f66-da7c-bbd4-6256" type="rule"/><infoLink id="c13d-3d4a-355a-2704" name="Fixed" hidden="false" targetId="b59b-2104-403e-f4a6" type="rule"/><infoLink id="f7d5-3546-a329-58e3" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/><infoLink id="5753-dd92-9d23-a6a7" name="AT Gun" hidden="false" targetId="c079-b951-5547-15db" type="rule"/></infoLinks><modifiers><modifier type="add" field="category" value="402e-4af1-db7f-959e"><conditions><condition type="atLeast" value="1" field="selections" scope="6131-74a3-2008-847c" childId="9b75-5b9e-471c-3e11" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="1164-c779-1f0d-5729" name="Aircraft" hidden="false" targetId="9cd4-4d03-18e5-5c89" primary="true"/><categoryLink id="4c24-d0ee-f30f-bc6f" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="13f5-35f6-4a56-7c94" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="51a2-4e2b-dcdc-b5ee"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5882-3e5b-88e3-afb0"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="de36-eff4-6d5b-df52"/></constraints><selectionEntries><selectionEntry id="51a2-4e2b-dcdc-b5ee" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b83f-4345-1ac9-739d"/></constraints><costs><cost name="pts" typeId="points" value="375.0"/></costs></selectionEntry><selectionEntry id="7753-bc8d-941d-df49" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3bd0-4a62-656e-19c7"/></constraints><costs><cost name="pts" typeId="points" value="450.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="eaa8-ed1e-5085-aacd" name="Vehicle Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="9b75-5b9e-471c-3e11" name="Command Vehicle" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="195b-9261-264e-4293"/></constraints><infoLinks><infoLink id="c800-6db1-b19c-d683" name="Command Vehicle" hidden="false" targetId="6768-ad5e-d28b-8396" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4fac-99a0-b3c4-8b5b" name="The Didact" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: The Didact requires at least 4 Forerunner Infantry units with Composed Beings. The Didact requires a Forerunner Knight Platoon Commander. The Didact requires at least one Warrior-Servant or Promethean Soldier Infantry unit.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="52e9-f1ef-74d5-9476"/></constraints><rules><rule id="0644-bc60-3bc4-63c9" name="Warden of the Mantle" hidden="false"><description>Once per game, when using the Warden of Balance army rule, you may use this rule. Instead of selecting one friendly Forerunner Infantry or Artillery unit, all friendly Forerunner Infantry units with Composed Beings gain +1 to hit when shooting until the end of that turn.</description></rule></rules><categoryLinks><categoryLink id="b45e-74fc-e570-a2c0" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="2afa-6375-5172-a60d" name="Leader: The Didact" hidden="false" targetId="62b8-928e-e27f-c4d4" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="50.0"/></costs></selectionEntry><selectionEntry id="ec62-9c21-a518-e4c1" name="343 Guilty Spark" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: 343 Guilty Spark cannot include a Knight Commander. 343 Guilty Spark requires a Monitor Company Commander. 343 Guilty Spark requires at least 3 Automaton Infantry units.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9314-65a4-6071-0801"/></constraints><rules><rule id="2290-983d-7f74-59d4" name="Containment Protocols" hidden="false"><description>Friendly Forerunner Automaton Infantry units may be affected by You men, snap to action! as if they did not have the Automaton special rule.

At the beginning of each turn, choose one friendly Forerunner Infantry unit. Until the end of that turn, any enemy unit that ends its movement within 6&quot; of that unit receives 1 Pin.

A unit may only receive 1 Pin per turn from this rule.</description></rule></rules><categoryLinks><categoryLink id="b1c0-827f-b948-3c50" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="d835-81a7-b8d8-1436" name="Leader: 343 Guilty Spark" hidden="false" targetId="c1d1-0fcb-529f-bafd" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="20.0"/></costs></selectionEntry></selectionEntries></catalogue>
