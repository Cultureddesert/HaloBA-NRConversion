-62fa">–</characteristic></characteristics></profile></profiles><rules><rule id="c5c6-ee75-48d0-22ae" name="Phase Blink" hidden="false"><description>Once per turn, when you fail an Evasion save for this vehicle, you may re-roll that save.</description></rule><rule id="e5d8-cd51-92f2-9422" name="Shield Pylon Deployment" hidden="false"><description>When this vehicle is given a Fire or Advance order, it may place up to two Shield Pylon Sentinels within 12&quot; instead of firing, removing any previously placed by this vehicle. Shield Pylon Sentinels count as obstacles only for enemy units. Friendly units ignore them for movement, but can gain hard cover from them. Enemy units never receive cover from them.</description></rule></rules><infoLinks><infoLink id="1139-ae30-d06c-44fc" name="Nimble" hidden="false" targetId="4285-d3d7-6be1-c061" type="rule"/><infoLink id="e181-e6b1-f2f1-c478" name="Shielded Hull" hidden="false" targetId="1bb2-189b-cc93-ac0a" type="rule"/></infoLinks><categoryLinks><categoryLink id="5f64-21c0-2a8f-3f9c" name="Aircraft" hidden="false" targetId="9cd4-4d03-18e5-5c89" primary="true"/><categoryLink id="cc30-87c2-4a72-1968" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="337f-4030-353e-c51e" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="8f49-3ee0-5799-aa1c"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="1953-c837-ea4d-bc53"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b7fd-ec42-a8e2-cd7b"/></constraints><selectionEntries><selectionEntry id="8f49-3ee0-5799-aa1c" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9b28-5363-a5ae-0383"/></constraints><costs><cost name="pts" typeId="points" value="95.