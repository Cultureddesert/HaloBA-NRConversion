. The attacker must be in range of the tank. Disembarking units are immediately placed within 1&quot; of the vehicle and automatically count as having gone Down or remain Down if already Down.</description></rule><rule id="aa29-511c-a3da-f376" name="Improved HE" hidden="false"><description>Instead of HE (1&quot;), the Medium Anti-Tank Weapon has HE (2&quot;).</description></rule></rules><infoLinks><infoLink id="7ad7-8766-957d-4fe8" name="Team" hidden="false" targetId="6f66-da7c-bbd4-6256" type="rule"/><infoLink id="f3a5-a283-ee85-5930" name="Fixed" hidden="false" targetId="b59b-2104-403e-f4a6" type="rule"/><infoLink id="bb50-8d81-0434-163d" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/><infoLink id="2e98-bcab-28a5-88c0" name="AT Gun" hidden="false" targetId="c079-b951-5547-15db" type="rule"/></infoLinks><modifiers><modifier type="add" field="category" value="402e-4af1-db7f-959e"><conditions><condition type="atLeast" value="1" field="selections" scope="3c14-2506-acad-f809" childId="df1a-ec61-165f-a219" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="6090-b229-e120-b4a4" name="Tanks &amp; Tank Destroyers" hidden="false" targetId="eaf2-7106-a937-484b" primary="true"/><categoryLink id="b795-6c20-a134-7713" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/><categoryLink id="9d7f-ad47-e7b9-54ca" name="Ground Transport Vehicle" hidden="false" targetId="8953-2a4c-8da1-ab0b" primary="false"/><categoryLink id="9f75-0cd0-b397-471c" name="Ground Transport Vehicle (DV 7+)" hidden="false" targetId="2b7f-c8a6-0ac4-1197" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="95f5-01de-0829-f937" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="f18f-9f89-8265-0325"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="552b-3c7