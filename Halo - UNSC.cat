0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4c17-64ee-2c4e-7eb7" name="Captain James Cutter" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Captain James Cutter requires at least 4 ODST Infantry units. Captain James Cutter requires an ODST Platoon Commander.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d14e-bd32-7322-a2aa"/></constraints><rules><rule id="a48f-f333-6b17-b5d3" name="Feet First into Hell" hidden="false"><description>ODST units and vehicles carrying only ODST units using Outflanking may attempt to enter the battlefield one turn earlier than normal. Treat the current turn as being one turn later when determining which table edges they may enter from. All other Outflanking rules apply as normal.

For example, on Turn 2, they enter as if it were Turn 3. On Turn 4, they enter as if it were Turn 5.</description></rule></rules><modifiers><modifier type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="68b0-4cb1-646b-1b36" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></conditionGroup></conditionGroups></modifier></modifiers><categoryLinks><categoryLink id="7790-fc8d-fdcf-6d6e" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="2f2c-749f-3406-5642" name="Leader: Captain James Cutter" hidden="false" targetId="62e0-1633-a813-59b2" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="30.0"/></costs></selectionEntry><selectionEntry id="e4ed-5c62-ea88-f347" name="Sergeant John Forge" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Sergeant John Forge requires at least 4 Trooper or Marine Infantry units. Sergeant John Forge requires a Trooper Platoon Commander or Marine Platoon Commander. Sergeant John Forge requires at least 2 non-flying Vehicles with transport capacity. Sergeant John Forge requires at least one transport Vehicle with Damage Value 7+ or higher.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d796-1d7b-fcb2-0387"/></constraints><rules><rule id="89b8-5551-f3a8-d079" name="Armoured Breakthrough" hidden="false"><description>Friendly UNSC Infantry units may re-roll failed Order tests made to mount or dismount a Vehicle. In addition, if a Vehicle carrying one or more friendly UNSC Infantry units is destroyed, those Infantry units suffer D3 hits instead of the standard D6 hits.</description></rule></rules><modifiers><modifier type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="68b0-4cb1-646b-1b36" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></conditionGroup></conditionGroups></modifier></modifiers><categoryLinks><categoryLink id="643f-445c-d9ce-802b" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="6629-7600-d2d0-0a80" name="Leader: Sergeant John Forge" hidden="false" targetId="d1b7-48b0-1cac-abc1" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="35.0"/></costs></selectionEntry><selectionEntry id="dc33-b7f6-7601-ef3d" name="Sergeant Major Avery Johnson" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Sergeant Major Avery Johnson requires at least 4 Marine Infantry units. Sergeant Major Avery Johnson requires a Marine Platoon Commander.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a48-0a55-bffa-5ab9"/></constraints><rules><rule id="72fe-644a-96a2-6225" name="Hold the Line!" hidden="false"><description>Once per game, when a friendly unit fails an Order test, you may use this rule: Remove all Pins from that unit and treat the Order test as passed instead.</description></rule></rules><modifiers><modifier type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="68b0-4cb1-646b-1b36" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></conditionGroup></conditionGroups></modifier></modifiers><categoryLinks><categoryLink id="414c-a801-2cb8-a7f5" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="c653-fdad-517f-0ecf" name="Leader: Sergeant Major Avery Johnson" hidden="false" targetId="e323-3228-99b0-e811" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="25.0"/></costs></selectionEntry><selectionEntry id="ebf9-a1be-847a-daf4" name="Commander Jerome-092" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Commander Jerome-092 requires at least 2 Spartan units. Commander Jerome-092 requires a Spartan Company Commander. Commander Jerome-092 requires 1 Marine Infantry unit for each Spartan unit beyond the first 2. Required Marines: ?,</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f324-a894-7d59-9acc"/></constraints><rules><rule id="2cda-5517-1771-6633" name="MJOLNIR Mobility" hidden="false"><description>When a Spartan unit is given a Run order, including an order to assault, and crosses rough ground or an obstacle, it may move up to 12 instead of halving its movement.</description></rule></rules><modifiers><modifier type="set" field="hidden" value="true"><conditionGroups><conditionGroup type="or"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="68b0-4cb1-646b-1b36" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></conditionGroup></conditionGroups></modifier></modifiers><categoryLinks><categoryLink id="9e39-f68f-e663-8647" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="b0cf-9a32-d539-eb7b" name="Leader: Commander Jerome-092" hidden="false" targetId="7b18-472f-04b3-c7e4" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="35.0"/></costs></selectionEntry><selectionEntry id="4eb9-e41e-a757-d3df" name="Kinsano" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Kinsano requires at least 4 Insurrectionist Infantry units. Kinsano requires at least 2 units armed with Flamethrowers.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e721-a5b0-f324-17b7"/></constraints><rules><rule id="2882-6bd2-6716-958d" name="Incendiary Warfare" hidden="false"><description>Friendly Insurrectionist units armed with Flamethrowers do not receive the usual 1 Pin marker for firing a Flamethrower.

In addition, when a friendly Insurrectionist Flamethrower rolls to see if it runs out of fuel, it only runs out on a 1 instead of a 1 or 2.

This affects both infantry flamethrowers and vehicle-mounted flamethrowers.</description></rule></rules><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="force" childId="68b0-4cb1-646b-1b36" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="8003-c1aa-4f7f-0514" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="f469-743c-2c94-223f" name="Leader: Kinsano" hidden="false" targetId="fdf8-4d64-c168-51fd" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="25.0"/></costs></selectionEntry></selectionEntries></catalogue>
