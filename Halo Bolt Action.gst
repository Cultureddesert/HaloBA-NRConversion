<modifier type="set" field="5e2b-1bdc-edfe-9f49" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="bec3-5244-428f-3b77" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="6252-ef75-bc69-18d2" name="Hunter Pack of 4" hidden="false" targetId="e8f3-2a63-f6c2-c1fa" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="3469-4206-3235-3789" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="3469-4206-3235-3789" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="df1f-d7b9-71cc-7656" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="9221-0e5c-5d50-f1ea" name="Skitterer" hidden="false" targetId="9d01-1bbb-ce26-252f" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="6896-26c8-6e61-f14d" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="6896-26c8-6e61-f14d" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="df1f-d7b9-71cc-7656" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="dd7d-79e9-bc15-29aa" name="Tank Form Pack, Spawner Form or Stalker Form Swarm" hidden="false" targetId="d237-615a-472c-c7fb" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="7dad-f29d-145c-3702" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="7dad-f29d-145c-3702" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="4c86-338f-0000-8789" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="f803-e417-efc3-adb5" name="Unit Barred by Feral Outbreak" hidden="false" targetId="d8bd-d5f7-b64f-4963" primary="false"><constraints><constraint type="max" value="-1" field="selections" scope="parent" shared="true" id="ad16-acde-88d9-6392" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="ad16-acde-88d9-6392" value="0"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="71eb-10d0-8e93-7505" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="0067-1a49-732a-358d" name="Composed Beings Infantry" hidden="false" targetId="a3d4-8fe1-f706-f020" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="8e7b-4175-b3ef-2550" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="8e7b-4175-b3ef-2550" value="4"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="62b8-928e-e27f-c4d4" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="057a-74be-4f1c-3090" name="Warrior-Servant or Promethean Soldier" hidden="false" targetId="349a-f8cb-014d-0c20" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="38db-0f6b-b63b-aa3c" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="38db-0f6b-b63b-aa3c" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="62b8-928e-e27f-c4d4" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="f7d1-9046-2be5-1f44" name="Monitor Company Commander" hidden="false" targetId="b235-cd4d-dc3a-a56d" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="f269-856f-2cdd-c7fc" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="f269-856f-2cdd-c7fc" value="1"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="c1d1-0fcb-529f-bafd" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="7c44-4c36-b3d7-7380" name="Automaton Infantry" hidden="false" targetId="ee87-91c7-2854-f4f1" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="8356-2f49-7f96-d770" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="8356-2f49-7f96-d770" value="3"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="c1d1-0fcb-529f-bafd" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink><categoryLink id="50b3-2548-0de9-2e4e" name="Flamethrower Unit" hidden="false" targetId="4808-9202-ab05-af09" primary="false"><constraints><constraint type="min" value="0" field="selections" scope="parent" shared="true" id="bf33-fd9a-e3f8-6187" includeChildSelections="false" includeChildForces="false"/></constraints><modifiers><modifier type="set" field="bf33-fd9a-e3f8-6187" value="2"><conditions><condition type="atLeast" value="1" field="selections" scope="force" childId="fdf8-4d64-c168-51fd" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers></categoryLink></categoryLinks></forceEntry></forceEntries><sharedRules><rule id="c079-b951-5547-15db" name="AT Gun" hidden="false"><description>All anti-tank guns, from light to super-heavy, including vehicle-mounted anti-tank guns, gain +1 to hit vehicles (Not vs flying aircraft) when firing with a Fire order, including Ambush and reaction fire.</description></rule><rule id="bfaf-0f80-9efb-00d0" name="Agile" hidden="false"><description>A vehicle with this rule may make an additional 90-degree pivot during its movement and is capable of pivoting 90-degrees on a Fire order.</description></rule><rule id="0a64-2a15-9b79-ca66" name="All-Terrain" hidden="false"><description>Wheeled vehicles with this rule may enter and move through rough ground with an Advance order, but may still not Run through rough ground.</description></rule><rule id="1f05-2bef-ba07-775a" name="Artillery" hidden="false"><description>Artillery are support team weapons and are usually Fixed. A gun model and its crew form a single unit; crew must remain within 1&quot; of the gun. Light/medium guns may Run only 6&quot; when manhandled; heavy/super-heavy guns, heavy howitzers, and guns reduced to 1 crewman cannot be moved by crew (they may rotate on an Advance order as normal for Fixed). Platform-mounted/rotating-platform guns may pivot freely on a Fire order (effectively 360° arc). If all crew are killed, the gun is abandoned and may be re-crewed. Artillery cannot assault, but can be assaulted; if defeated in close combat, both gun and crew are destroyed.</description></rule><rule id="ace5-f449-988a-f190" name="Assault" hidden="false"><description>No -1 to hit when moving and shooting. Models with an Assault weapon gain Tough Fighters: When fighting in close quarters against Infantry, Artillery, or Assault Walkers, a unit may re-roll a number of failed melee rolls up to the number of friendly models with Tough Fighters taking part in that fight.</description></rule><rule id="acaf-5768-cafe-68f2" name="Attached Caste Leader" hidden="false"><description>An Attached Caste Leader is an embedded leader model added to a squad. While non-leader models remain, the leader and squad count as one unit, sharing one Order Die, one pool of Pins, one activation and normal coherency. Special rules do not normally pass between them. Unit-wide rules such as movement, routing, compulsory behaviour, Order tests and Morale tests use the squad’s rules, though tests use the highest veterancy present. Rules that specifically affect the leader’s attacks, Damage Value, saves, weapons or other model-specific effects still apply normally. While attached, the leader cancels Shirkers and the unit ignores the -1 Morale penalty for losing its NCO. Shooting and Close Quarters attacks may be allocated between the leader and squad before rolling; resolve each separately and casualties do not spill between them. If all non-leader models are removed, the leader becomes a separate unit, retaining the unit’s Pins, Order Die and activation state, and then uses its own profile and special rules in full.</description></rule><rule id="99ad-0593-5933-619d" name="Automaton" hidden="false"><description>Ignore Horror's -1 morale effects and immune to Flood Infection, cannot benefit from medics or 'You men, snap to action!' orders.</description></rule><rule id="a7bd-6f9a-4bec-fd25" name="Behind Enemy Lines" hidden="false"><description>Ignores the -1 penalty when performing Reserve/Outflank order tests.</description></rule><rule id="3826-3f4f-7162-172c" name="Berserker" hidden="false"><description>When performing an assault, models gain one extra Attack die during the first round of that close combat. Additionally, if an Order test is failed (excluding FUBAR) and an enemy Infantry/Artillery unit is within assault reach, this unit must Run (Assault) the nearest eligible target. Otherwise resolve the failed test as normal (Down).</description></rule><rule id="2e89-54dc-6d24-c4b1" name="Brood Sac" hidden="false"><description>If this unit is not Down, when a friendly Flood Infantry unit successfully enters from Reserve, it may deploy by eruption instead of from a table edge. Remove the Spawner; it counts as destroyed. Place the entering unit with at least one model within 1&quot; of the Spawner’s former position, outside any building and with all models in a legal position according to the rules. The unit goes Down and takes no further action. If it cannot be placed, it remains off-table and the Spawner is not removed.</description></rule><rule id="f3b3-2a2c-e674-0e3a" name="Brute Grenadiers" hidden="false"><description>Double the number of shots made by this unit’s weapons. In addition, if this unit is destroyed in Close Quarters, the enemy unit involved immediately suffers one HE (1&quot;) hit.</description></rule><rule id="7624-0a81-23a0-7cef" name="Champion" hidden="false"><description>Upgrade for the NCO. The Champion follows the rules for a Platoon Commander, except his Morale bonus bubble is only +1, and his You men, snap to action! may only issue an order to 1 other friendly Grunt/Jackal unit. The Champion counts as an Officer, but is not a Officer HQ and does not fulfil the requirement for a Platoon Commander.</description></rule><rule id="f7a3-6790-75d7-874e" name="Charged Beam" hidden="false"><description>When firing at a unit that has an Advance or Run order, this weapon suffers an additional -1 to hit. On a hit, extend a straight line 6&quot; beyond the target. The first unit crossed, friend or foe, may also be hit; make a separate To Hit roll at an additional -1.</description></rule><rule id="6768-ad5e-d28b-8396" name="Command Vehicle" hidden="false"><description>Vehicles with this rule are equipped with enhanced communication systems that provide a morale bonus of +1 to themselves and all friendly vehicles within 12&quot;. Additionally, a Command Vehicle can issue one 'You men, snap to action!' order to a single friendly vehicle within 12&quot;, except other Command Vehicles.</description></rule><rule id="688c-640e-a83a-f388" name="Company Commander" hidden="false"><description>+4 Morale within 12&quot;. Snap: after a successful order other than Down, may issue up to 4 orders to friendly units within 12&quot;.</description></rule><rule id="2216-3794-2c1f-4906" name="Composed Beings" hidden="false"><description>Ignore Horror's -1 morale effects, immune to Flood Infection and cannot benefit from medics.</description></rule><rule id="01b8-44d8-6c8a-755d" name="Cover Piercing" hidden="false"><description>When this weapon hits an Infantry or Artillery unit that is in soft/hard cover and not Down, any natural 6 rolled to Wound worsens the target’s cover save by 1, for that wound only.</description></rule><rule id="f7dc-96df-cb3f-9b5c" name="Deacon" hidden="false"><description>Upgrade for the NCO. The Deacon follows the rules for a Platoon Commander, except his Morale bonus bubble is only +1, and his You men, snap to action! may only issue an order to 1 other friendly Grunt/Jackal unit. The Deacon counts as an Officer, but is not a Officer HQ and does not fulfil the requirement for a Platoon Commander.</description></rule><rule id="07f3-cda4-4add-de67" name="Energy Shield" hidden="false"><description>+1 harder to damage from shooting.</description></rule><rule id="ce2a-9067-a943-7635" name="Energy Shields" hidden="false"><description>+1 harder to damage from shooting.</description></rule><rule id="608d-262e-583f-222b" name="Engineers" hidden="false"><description>When assaulting a building, defenders lose Defensive Position.</description></rule><rule id="1125-9eac-a880-18fc" name="Fanatics" hidden="false"><description>Ignore pin modifiers on morale checks and are not routed by pins. If defeated in close quarters, fight again immediately until they win or are wiped out.</description></rule><rule id="ec35-1648-96bf-9d9d" name="Fast" hidden="false"><description>Move 8&quot;; Run 16&quot;.</description></rule><rule id="d98c-d470-fc10-25e4" name="Faster" hidden="false"><description>Vehicles with the Faster rule benefit from enhanced mobility. Fast vehicles can move 12&quot; with an Advance order and 24&quot; with a Run order.</description></rule><rule id="7589-197f-fba6-ec18" name="Fieldcraft" hidden="false"><description>Treat rough terrain as open ground for movement. When assaulting through rough ground, defenders lose Defensive Position gained from that Rough Ground.</description></rule><rule id="e733-c9e7-da15-16e1" name="Fist" hidden="false"><description>Some walkers are equipped with powerful mechanical fists designed for devastating close-quarters combat. Walkers with this rule gain an additional attack dice in close quarters for each fist they possess. This rule only applies in close combat.</description></rule><rule id="b59b-2104-403e-f4a6" name="Fixed" hidden="false"><description>Fixed weapons can only fire within a 90-degree arc. A Run order must be used to reposition them. Cannot perform assaults.</description></rule><rule id="6402-5993-c584-f7e1" name="Flak" hidden="false"><description>Autofires at FAO called aircraft in arc and range (5+). However against on table aircraft just ignore minus 1 to hit vs flying. Remember: Pintle mounted weapons count as having Flak too.</description></rule><rule id="86ea-e02e-eee5-c675" name="Flamethrower" hidden="false"><description>Roll 1 die to hit. If it hits, an infantry Flamethrower inflicts D6 hits, while a vehicle-mounted Flamethrower inflicts D6+1 hits. No cover saves, including Down saves. Target takes D3+1 Pins and must pass Morale or be destroyed/knocked out. Hits vehicles on top armour and ignores long/point-blank Pen modifiers. Fuel may run out after use. Against buildings, needs an opening and may set normal buildings on fire on 4+ even if it misses.</description></rule><rule id="ee90-a0ce-da69-8d5c" name="Flight" hidden="false"><description>Advance 12&quot;; Run 18&quot;; ignore terrain for movement. Cannot end in impassable terrain, or in rough ground after a Run. If ambushed while flying, no soft/hard cover saves. Cannot pick up or carry objectives while resolving a Run order, but may claim or take possession of an objective after a Regroup move. Infantry may instead move on the ground using normal movement rules and any other movement rules the unit has.</description></rule><rule id="52d0-d1fe-926f-de73" name="Flood Burster" hidden="false"><description>When successfully entering from Reserve, one unit per turn with this rule may deploy via a Flood Burster instead of from a table edge: place it legally in open ground more than 9&quot; from enemies, then give it Down. It cannot perform further actions that turn.</description></rule><rule id="24cd-a6a9-7341-a58c" name="Flood Infection" hidden="false"><description>Automatons and Composed Beings are immune to this rule. When winning vs Infantry or Artillery in CQ, immediately roll one D6 per enemy model removed during and after combat. Each roll equal to or above this flood unit’s damage value returns a slain model (up to starting size). If the flood unit has Energy Shields, it increases the requirement by +1.</description></rule><rule id="3a58-e86f-26dd-5171" name="For Humanity’s Survival!" hidden="false"><description>This unit may be customized to represent a UNSC sub-faction (Troopers, Recon, Marines, ODSTs or Spartans). Choose its doctrine in the unit options. Apply all associated rules and point costs to every model in the squad; mixed designations are not allowed within the same unit.</description></rule><rule id="017f-a563-35be-77e0" name="For The Great Journey!" hidden="false"><description>This unit may be customized to represent a Covenant warrior caste (Grunts/Jackals, Skirmishers, Elites or Brutes). Choose its doctrine in the unit options. Apply all associated rules and point costs to every model in the squad; mixed designations are not allowed within the same unit.</description></rule><rule id="afdc-e422-e1f8-44b3" name="Forged In Chains" hidden="false"><description>This unit may be customized to represent a Banished warrior caste (Grunts/Jackals, Skirmishers, Elites or Brutes). Choose its doctrine in the unit options. Apply all associated rules and point costs to every model in the squad; mixed designations are not allowed within the same unit.</description></rule><rule id="bb9c-5735-f5d1-66bd" name="Gravity Hammer" hidden="false"><description>A model with a Gravity Hammer gains Tough Fighters. While this unit is fighting in close quarters, the Gravity Hammer wielder gains +1 extra melee attack for every full 3 enemy models involved in the fight. If a unit containing a Gravity Hammer is assaulted in open ground while it is not Down, it counts as having Defensive Position.</description></rule><rule id="1e79-2ce1-83db-68a6" name="Gravity Lift" hidden="false"><description>While Flying, if this Aircraft has not moved yet this turn, transported infantry units may disembark from it as though it were Landed.</description></rule><rule id="6097-aca1-aa48-4716" name="Green" hidden="false"><description>First casualty triggers a D6 roll: 1 = gain D6 pins and go Down, 6 = unit upgraded to Regular (morale 9 and DV 4+).</description></rule><rule id="e444-4b34-568a-9837" name="Gun Shield" hidden="false"><description>Crew of a gun with a gun shield count as in soft cover vs small arms hits from within the gun’s front arc.</description></rule><rule id="c659-80b2-bebe-eb79" name="HE" hidden="false"><description>Choose HE or AT shot before firing if the weapon has both. HE must be used vs infantry/artillery. HE uses a template: place it to hit as many target models as possible without touching friends. Other enemy units touched are hit but take no pins. If a unit fires multiple HE shots at the same target, roll all hits first, then place one template for each HE hit and count the total number of unique models covered. A model can only be hit once by HE from the same firing unit, even if covered by more than one template. Multiple HE shots from one unit cause only one HE pin result.</description></rule><rule id="77c7-7a01-0e2e-d32f" name="Hard-Light Calibration" hidden="false"><description>Weapons fired by this unit gain the Cover Piercing weapon rule.</description></rule><rule id="ffcf-0cd9-ce23-56c5" name="Hardened" hidden="false"><description>5+ cover save against shooting attacks in the open; improves soft/hard cover saves by +1</description></rule><rule id="7ca1-ba40-b31e-ff57" name="Hardlight Screen" hidden="false"><description>While this unit is not Down, friendly Infantry and Artillery units drawing cover from this unit may treat that cover as hard cover instead of soft cover. The line of fire should pass through or within 1&quot; of this unit. This rule does not improve cover for the unit itself.</description></rule><rule id="32b8-0947-07dc-92d9" name="High Resolve" hidden="false"><description>Whenever this unit successfully passes an Order test by rolling a double, it counts as having rolled Incredible Courage! and immediately removes all of its Pin markers rather than just one.</description></rule><rule id="8d17-f961-100c-1c5d" name="Horror" hidden="false"><description>Units with Horror are immune to Horror. Assaulting a Horror unit requires an Order test at -1 morale, even if unpinned. When this unit assaults, the target takes a Morale check at -1 before reacting; if failed, it goes Down (loses Defensive Position).</description></rule><rule id="a4f9-9d7c-a90c-4283" name="Howitzer" hidden="false"><description>Fires either direct with no minimum range or Indirect Fire (minimum range applies; starts hitting at 6+, improves each turn targeting same unit unless moving). Switching spotter also resets accuracy progression.</description></rule><rule id="9231-b662-ca19-3522" name="Impulse Drive" hidden="false"><description>At the start of this vehicle's activation, you may declare Impulse Drive. During this activation, when this unit Advances or Runs it ignores other models and terrain for movement (distances unchanged; no road bonus), but it cannot end its move on impassable terrain, in buildings, in rough ground, or within 1&quot; of enemy units (unless assaulting per assault walker rules). Any Ambush fire resolved during this movement treats the vehicle as in the open (no cover saves); after it finishes moving, resolve cover normally for subsequent attacks.</description></rule><rule id="6578-de34-1b6e-619f" name="Indirect Fire" hidden="false"><description>Cannot fire within minimum range. Starts hitting on 6+, improving each turn against the same unmoved target if the firer does not move. Ignores normal to-hit modifiers. No cover saves; Down halves HE hits. Hits vehicles on top armour. Resets if target/firer moves, target changes, or spotter changes.</description></rule><rule id="cf72-9bea-32bc-fb8b" name="Infested Terrain" hidden="false"><description>Once per army, one unit with this rule fully within a terrain may make that terrain Infested Terrain. It cannot be a road, objective marker, bunker, impassable terrain, or terrain containing an objective. At the end of an enemy non-Flood Infantry/Artillery unit’s activation, if it moved across/through/touching it or has a model inside/touching it, it gains 1 Pin. A unit can only gain 1 Pin per turn from this rule.</description></rule><rule id="c4aa-6536-5471-bd48" name="Infiltrator" hidden="false"><description>+1 cover if stationary (no Advance/Run orders) against shooting attacks. Can use special deployment rules if scenario allows.</description></rule><rule id="331a-079a-97f6-2690" name="Knight Commander" hidden="false"><description>The added officer model is considered a Platoon Commander and this unit takes a Platoon Commander slot from a platoon. The Knight Commander remains part of this unit. While the Knight Commander is alive, the unit does not suffer the effects of losing its NCO.</description></rule><rule id="d252-90e6-fdf3-f443" name="Knockback" hidden="false"><description>After an ungarrisoned infantry unit takes at least 1 hit, roll D6: on 4+, it gains 1 pin and must move 3&quot; directly away. If this would move it into impassable terrain, a building, a table edge or another unit, it stops 1&quot; short.</description></rule><rule id="a6ac-b14c-a013-638c" name="Large Infantry" hidden="false"><description>Counts double for transport capacity. When this unit assaults or is assaulted, opponent loses Defensive Position.</description></rule><rule id="3714-2463-455d-3c3f" name="Linked" hidden="false"><description>All shots from this weapon must target the same enemy unit.</description></rule><rule id="c7ff-e8a5-14f1-69c8" name="M301 Grenade Launcher" hidden="false"><description>Carried in addition to the model’s other weapon. When shooting, that model may fire either the M301 or its other weapon, not both.</description></rule><rule id="060b-ebc9-9e96-cb17" name="MG" hidden="false"><description>Behaves exactly like a standard machine gun for all game rules and modifiers.</description></rule><rule id="da88-f60a-2f7f-58f4" name="MJOLNIR Systems" hidden="false"><description>Models have a 5+ cover save in Close Quarters and add +1 to their soft/hard cover saves. In addition, each time this unit suffers damage, roll one D6 for each point of damage before removing casualties. On a 6, that damage is ignored and no casualty is caused. This does not stack with the Medic rule.</description></rule><rule id="4a81-2150-895c-cd39" name="ML" hidden="false"><description>Never ranges in better than 6+. After placing the original template, all enemy units within 6&quot; of it also become targets; roll 6+ separately for each. Cannot fire if friends are within 6&quot; of the original template. Firer takes 1 pin.</description></rule><rule id="0eb6-2d04-ecff-2d3e" name="Medic" hidden="false"><description>If the medic’s own unit, or any friendly Infantry or Artillery unit with at least one model within 6&quot; of the medic model, suffers damage from Small Arms fire, roll one die for each point of damage before removing casualties. On a 6, that damage is ignored and no casualty is caused.</description></rule><rule id="3537-fa64-7612-7061" name="Medical Vehicle" hidden="false"><description>Being in proximity of an ambulance means that any wounded soldiers nearby have a chance of being treated by a medic or stretcher bearer from amongst the crew of the ambulance. All infantry and artillery units within 6&quot; of the vehicle count as within 6&quot; of a medic. Ambulances are destroyed if they end their turn closer to enemy units than to friendly units. (Bolt Action Rulebook V3, p149)</description></rule><rule id="c2ca-14a1-996b-1dfd" name="Melee Weapon" hidden="false"><description>In close combat, Officer/NCO rolls 1 additional dice.</description></rule><rule id="4eca-e95a-0f1f-454e" name="Melee Weapons" hidden="false"><description>Every model makes 2 base attacks in close quarters instead of 1.</description></rule><rule id="4285-d3d7-6be1-c061" name="Nimble" hidden="false"><description>Aircraft with this rule are exceptionally agile. This aircraft's Evasion save improves by +1 (4+ instead of 5+).</description></rule><rule id="f1f9-8df8-5644-68d9" name="One-Shot" hidden="false"><description>The weapons can only be fired once during the game (replace the model after firing). Models within a unit carrying one-shot weapons can split fire against different targets from the other models.</description></rule><rule id="9f53-15e2-e2eb-9ee8" name="Open-topped" hidden="false"><description>Vehicles with this rule are more vulnerable to attacks and offer less protection to their occupants. They are pinned by small-arms fire like soft-skinned vehicles and automatically destroyed in assaults if damaged. If hit on the top armor, they suffer an additional +1 to the damage roll and damage table.</description></rule><rule id="6d26-0b1c-9158-3552" name="Overcharge" hidden="false"><description>Before shooting, choose Overcharge: can pin vehicles up to damage value 9+ or ignores Energy Shield's +1 to wound difficulty but imposes a -1 to-hit penalty.</description></rule><rule id="7215-1a4f-dbf9-0053" name="Overheat" hidden="false"><description>Before shooting, choose which weapons to overheat; each overheated weapon gains +1 shot. After shooting, place 1 pin on the firing unit for each overheated weapon.</description></rule><rule id="cffa-d173-9cce-011f" name="Paired" hidden="false"><description>Paired machine guns do not halve their shots when mounted on a vehicle.</description></rule><rule id="eaee-0cd6-45fa-107a" name="Pathfinder" hidden="false"><description>After both sides finish setup but before the first turn, if this unit is on the battlefield and did not deploy using the Infiltrator special rule, it may make a Run move. During this move, it cannot assault and cannot be targeted by enemies in Ambush.</description></rule><rule id="5202-2062-66fb-94e2" name="Patient Predators" hidden="false"><description>If this unit is in cover from enemy shooting while it has an Ambush order, improve its Cover Save by +1. Remember rolls of 1 always fail.</description></rule><rule id="fe9b-6d23-ef5c-f722" name="Plasma Capacitor Cells" hidden="false"><description>After using Overheat, roll one D6 per overheated weapon; each 4+ removes one Pin generated by that Overheat.</description></rule><rule id="acb0-34e6-583e-7fbd" name="Plasma Sword" hidden="false"><description>A model with a Plasma Sword gains Tough Fighters. When this model fights in close quarters, it may use the Plasma Sword. If it does, reduce this model’s number of total attacks by 1. Attacks made with the Plasma Sword gain +1 to wound against Infantry and Artillery units. If these attacks cause at least one casualty, you may choose an enemy NCO, Officer, or unit leader in the target unit as one of the casualties caused by this model.</description></rule><rule id="d64b-7cdb-29ec-6b71" name="Platoon Commander" hidden="false"><description>+2 Morale within 6&quot;. Snap: after a successful order other than Down, may issue up to 2 orders to friendly units within 6&quot;.</description></rule><rule id="b1aa-551b-da35-ea4b" name="Range Finder" hidden="false"><description>When a weapon with Range Finder is fired, it may re-roll any natural hit rolls of 1. This only applies to attacks made by the weapon with Range Finder .</description></rule><rule id="407d-096b-bcb5-33fc" name="Rappelling Lines" hidden="false"><description>While Flying, if this Aircraft has not moved yet this turn, transported Infantry units may disembark from it as though it were Landed.</description></rule><rule id="e154-dc6a-0a17-0162" name="Recce" hidden="false"><description>Reconnaissance vehicles can perform special escape reactions when shot at, moving with an Advance or Run order to avoid damage. They may also reverse at full Advance speed. Specific rules for their escape reactions apply during shooting and assaults, as detailed in the main rules.</description></rule><rule id="30cd-7d8b-30dd-4932" name="Reconstruction Matrix" hidden="false"><description>After a successful Rally order, roll 1D6 for each missing model. If one or more results equals/exceeds this unit’s DV, return 1 removed model, up to starting size. Energy Shields worsen the required result by +1, max 6+. Max 1 model returned per Rally.</description></rule><rule id="2fca-b3ac-350d-0d37" name="Reinforced Front Armour" hidden="false"><description>Vehicles with this rule count their front armor as 1 higher than their listed value against all shots hitting the front arc.</description></rule><rule id="c4d8-8191-74be-01f2" name="Resilient" hidden="false"><description>DV 6+; 5+ cover in open or CQ; +2 to soft/hard cover saves. Remember rolls of 1 always fail.</description></rule><rule id="7a6e-828b-ee4f-4106" name="Sacred Relic" hidden="false"><description>A designated non-Officer/NCO Elite model carries the relic. Friendly Covenant Infantry and Artillery within 12&quot; and LoS of that model may re-roll failed Morale checks.</description></rule><rule id="d70a-2251-1bab-b175" name="Scrap Armour Screens" hidden="false"><description>Weapons with Shaped Charge do not gain +1 Penetration bonus for hitting this vehicle in the side arc.</description></rule><rule id="9ede-218d-bbb4-33a1" name="Shaped Charge" hidden="false"><description>Ignores the -1 Penetration penalty at long range and does not gain the +1 Penetration bonus at point-blank range. Against units in buildings, if fired at a visible wall, it counts as HE (2&quot;).</description></rule><rule id="fb0f-692b-6245-7c0a" name="Shield Wall" hidden="false"><description>6+ cover save in open ground, improved by +2 if unit is Down (4+). Improves other existing cover by 1. Remember rolls of 1 always fail.</description></rule><rule id="1bb2-189b-cc93-ac0a" name="Shielded Hull" hidden="false"><description>When resolving a shooting attack against this vehicle, if this vehicle had no Pin markers when the attack was declared, reduce the Penetration value of each hit by 1, to a minimum of 0. If this vehicle had one or more Pin markers when the attack was declared, this rule has no effect.</description></rule><rule id="cdfb-a3d2-7e7c-ec26" name="Shirkers" hidden="false"><description>Pins count double. Must always test for orders.</description></rule><rule id="bd3f-7e85-734f-43d8" name="Slow" hidden="false"><description>Move 4&quot;, Run 8&quot;.</description></rule><rule id="b110-1234-d0dc-cd41" name="Slow Load" hidden="false"><description>Some vehicles have very powerful guns, but their loading mechanisms cannot move their huge shells fast enough to keep up a high rate of fire. The vehicle cannot be given an order until at least one other unit on the same side has already been given orders (whether successfully or not). If an army is left with a number of units which all have the Slow Load special rule, when the army receives its first order dice of the turn, put the dice back in the bag and draw again. The next dice drawn for that army can then be allocated to a model with slow load as if another unit had already been ordered. (Bolt Action Rulebook V3, p151)</description></rule><rule id="3475-b3f7-37bc-ef72" name="Slower" hidden="false"><description>Vehicles with this rule are less mobile, moving only 6&quot; with an Advance order and 12&quot; with a Run order.</description></rule><rule id="66be-2e81-8ca5-6597" name="Sniper" hidden="false"><description>Grants unit the Sniper special rule.</description></rule><rule id="81ef-2e27-9c66-b379" name="Spore Cloud" hidden="false"><description>When this unit is destroyed, place one 3&quot; smoke marker anywhere within 6&quot; of the last model removed. This smoke marker follows the normal Smoke rules. When a unit with Flood Infection wins Close Quarters, it may roll one additional Flood Infection die if either unit in that combat is within 3&quot; of a Spore Cloud marker.</description></rule><rule id="2b8d-429a-7221-721b" name="Spotter" hidden="false"><description>Unarmed model with Infiltrator rule for an indirect-fire team. Acts separately, shares the team’s order die, counts as Down without a die, cannot attack/capture. Removed if the unit is destroyed. Reg/Vet indirect fire/howitzer units may target what any friendly spotter/FO can see.</description></rule><rule id="39ef-cc7c-1fd3-bb28" name="Stealth" hidden="false"><description>Extra -1 to hit penalty for enemies targeting this unit if it is Down.</description></rule><rule id="06e5-c12c-c76c-c8d1" name="Strikes First" hidden="false"><description>When this unit assaults, it fights first as if it had Defensive Position. If the assaulted unit also has Defensive Position, Strikes First, or a rule that cancels either, both sides fight simultaneously instead.</description></rule><rule id="3126-cc8a-a2dd-7dbe" name="Strong" hidden="false"><description>Ignores Team and Fixed for weapons this unit carries. In close quarters, for every three friendly models involved in the fight, 1 model rolls an extra attack die.</description></rule><rule id="56f4-3674-15fc-d3a9" name="Stubborn" hidden="false"><description>Ignores pin modifiers on morale checks (but not order tests).</description></rule><rule id="dab7-aaa1-1638-9916" name="Supercombine" hidden="false"><description>Each natural roll of 6 to hit allows rolling an extra die to wound against the same target, even when using HE.</description></rule><rule id="9d9c-6aae-c4c4-f87f" name="Sustained Beam" hidden="false"><description>If an AT Gun on this unit hits its target, draw a straight line from this unit to that target. Each other enemy unit crossed by the line may also be hit; make a separate To Hit roll at -1 for each, plus any other modifiers that may apply. Flying Aircraft are ignored for this rule. If the original target is a Flying Aircraft, this rule does not apply.</description></rule><rule id="94e0-aa25-ea6d-2b93" name="Tank Hunters" hidden="false"><description>In assaults, use full anti-tank damage rules and ignore Tank Fear. Add +1 to damage rolls vs vehicles in CQ.</description></rule><rule id="6f66-da7c-bbd4-6256" name="Team" hidden="false"><description>Weapon with this rule requires at least 2 models to fire at full effect. If only 1 model remains, the weapon may still fire but suffers -1 to hit. For squad-based Team Weapons, a loader must be within 1&quot; of the weapon carrier; when the Team Weapon fires, the loader cannot fire their own weapon. If the loader is killed or is not within 1&quot;, the Team Weapon suffers -1 to hit.</description></rule><rule id="5429-2a97-44ce-09ef" name="Team Weapon" hidden="false"><description>Crew-served unit weapon. Support weapon team crew count as unarmed and do not fire personal ranged weapons. A Team Weapon belongs to the unit. A Team Weapon needs at least 2 models to fire at full effect; if only 1 model remains, the weapon may still fire but suffers -1 to hit.</description></rule><rule id="34ab-5e26-7b12-2ea7" name="Tooth and Claw" hidden="false"><description>Rolls 3 dice instead of 1 per model in close combat.</description></rule><rule id="5615-e6c8-37bd-dd58" name="Tough Fighters" hidden="false"><description>In close quarters against Infantry, Artillery, or Assault Walkers, a unit may re-roll a number of failed melee rolls up to the number of friendly models with Tough Fighters taking part in that fight.</description></rule><rule id="e20f-eab6-7692-9069" name="Tracking" hidden="false"><description>Ignores the -1 to-hit penalty caused by pinning when issued a FIRE order.</description></rule><rule id="2f95-728b-829e-8c95" name="Translocation Deployment" hidden="false"><description>Only one unit per army per turn may use this rule. When entering by Outflanking with a Run order, the unit may instead deploy anywhere legal on the battlefield, more than 9&quot; from enemy units and objectives, and not inside a building. It makes no Run move and remains there for the rest of the turn.</description></rule><rule id="c745-d799-4fd3-a6f1" name="Trophy Plate Harness" hidden="false"><description>Models have a 6+ cover save in Close Quarters.</description></rule><rule id="6e3d-d273-9926-fcfd" name="Unreliable" hidden="false"><description>If the vehicle suffers one or more pin markers as a result of an enemy attack, it automatically suffers one further pin marker in addition, such is its extreme operational unreliability. (Bolt Action Rulebook V3, p151)</description></rule><rule id="553d-66c6-4264-749b" name="VISR" hidden="false"><description>Can see through smoke and ignores Stealth’s -1 to-hit penalty.</description></rule><rule id="7da2-2780-b52a-b2d3" name="War Sermon" hidden="false"><description>When this unit receives its order die (except Down), pick 1 friendly Covenant Infantry or Artillery unit within 6&quot; and roll a D6 (Inexperienced -1, Veteran +1). On a 4+, remove 1 pin from that unit.</description></rule><rule id="69e7-0419-e5f4-37ca" name="Weak Sides" hidden="false"><description>Vehicles with this rule have vulnerable side armor. Attacks against the sides count as hitting the rear, gaining a +2 penetration modifier instead of +1.</description></rule><rule id="ddd5-7152-2e25-0414" name="Wide Formation" hidden="false"><description>Models may maintain up to 2&quot; coherency (instead of 1&quot;).</description></rule><rule id="8c24-3b69-31ee-68ed" name="XM20P Grenades" hidden="false"><description>When a weapon with XM20P Grenades hits a unit with Energy Shields or Shielded Hull, ignore those rules for that weapon’s attack.</description></rule></sharedRules><sharedProfiles><profile id="2154-e221-3925-b7db" name="Pistol" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">12&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">–</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">–</characteristic></characteristics></profile><profile id="3a47-7aee-8cef-6c60" name="Boltshot" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">12&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">–</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">–</characteristic></characteristics></profile><profile id="b7e1-9187-8c0a-811b" name="Plasma Pistol" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">12&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><chara