rmed" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><modifiers><modifier type="increment" field="1c44-f79c-f5d5-65a2" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="fee3-a855-f139-e83e" childId="8877-ec43-043d-a959" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier><modifier type="decrement" field="1c44-f79c-f5d5-65a2" value="10"/></modifiers><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">10</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">–</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">–</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">–</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">No ranged weapon</characteristic></characteristics></profile></profiles><rules><rule id="2994-34f5-4774-a1be" name="Assimilate" hidden="false"><description>If this unit wins an assault against a target affected by Flood Infection, compare the target’s number of models at the start of the combat to the number of surviving Infection Forms. If the target began with at least half as many models (rounding down), you may replace each surviving Infection Form with an unarmed Combat Form. The unit immediately becomes Regular, uses the Combat Form rules instead, and retains its current Order Die.</description></rule><rule id="793c-ab29-bd10-0548" name="Mindless Hunger" hidden="false"><description>This unit cannot pick up, carry, score or control objectives. It may still contest objectives.</description></rule></rules><infoLinks><infoLink id="71cb-1641-2f01-33f2" name="Horror" hidden="false" targetId="8d17-f961-100c-1c5d" type="rule"/><infoLink id="1644-e490-b04e-64b7" name="Fieldcraft" hidden="false" targetId="7589-197f-fba6-ec18" type="rule"/><infoLink id="3313-6388-bd58-0b6c" name="Behind Enemy Lines" hidden="false" targetId="a7bd-6f9a-4bec-fd25" type="rule