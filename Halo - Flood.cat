 Walker)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile></profiles><rules><rule id="c0de-9086-ca16-1b8e" name="Synaptic Relay" hidden="false"><description>If at least one Flood Officer is alive, this unit extends that officer’s command bubble to Flood Infantry and Artillery within 6&quot; of it, but with the morale bonus halved. For normal morale checks, affected units use the highest officer’s morale bonus available (halved). For Snap To via this relay, only the activating officer’s halved morale bonus is used, even if another officer on the field has a higher bonus.</description></rule></rules><infoLinks><infoLink id="6766-8283-0feb-78fd" name="Forward-facing Tentacle Lash" hidden="false" targetId="d5d5-b68e-1ba0-b003" type="profile"/><infoLink id="0fb5-5ed4-b2b9-863c" name="Shaped Charge" hidden="false" targetId="9ede-218d-bbb4-33a1" type="rule"/><infoLink id="d68d-48c3-412e-0999" name="Fist" hidden="false" targetId="a6de-42ba-3892-c3b8" type="profile"/><infoLink id="e004-b7e4-d831-da23" name="Assault" hidden="false" targetId="ace5-f449-988a-f190" type="rule"/><infoLink id="1fd0-0961-2cc3-e854" name="Fist" hidden="false" targetId="e733-c9e7-da15-16e1" type="rule"/><infoLink id="f92d-ab21-1aae-6d17" name="Agile" hidden="false" targetId="bfaf-0f80-9efb-00d0" type="rule"/><infoLink id="b313-7c95-d792-2651" name="Faster" hidden="false" targetId="d98c-d470-fc10-25e4" type="rule"/><infoLink id="acf0-5713-cf3a-20d6" name="Open-topped" hidden="false" targetId="9f53-15e2-e2eb-9ee8" type="rule"/></infoLinks><modifiers><modifier type="add" field="category" value="de03-be30-08bc-3183"><conditions><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier><modifier type="add" field="category" value="c868-ee48-0704-5a98"><conditions><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier><modifier type="add" field="category" value="325c-588c-4a24-ce36"><conditions><condition type="lessThan" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier><modifier type="add" field="category" value="402e-4af1-db7f-959e"><conditionGroups><conditionGroup type="and"><conditions><condition type="lessThan" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="adbc-7495-454f-96cd" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></conditionGroup></conditionGroups></modifier><modifier type="add" field="category" value="fc3d-0c75-8e93-03e0"><conditions><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="cd8d-dd9b-5737-d3a7" name="Walkers" hidden="false" targetId="1d11-002e-4141-d18a" primary="true"/><categoryLink id="381f-27d0-3289-a910" name="Unit Barred by Feral Outbreak" hidden="false" targetId="d8bd-d5f7-b64f-4963" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="651a-4c83-f9cb-88c3" name="Juggernaut Key Mind" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b8d1-b23f-840e-d07b"/></constraints><rules><rule id="bf3b-2516-41de-cead" name="Juggernaut Key Mind" hidden="false"><description>A Juggernaut Key Mind gains the Platoon Commander special rule and fills one Platoon Commander slot in a platoon. For all other purposes, it remains a Walker. However, it does not count towards an Armoured Platoon’s composition, vehicle limits, or vehicle requirements, and is ignored when determining any other force-organisation requirements or limits based on vehicles. A Juggernaut Key Mind cannot also be a Command Vehicle.</description></rule><rule id="7da9-207b-46bb-b3a6" name="Limited" hidden="false"><description>Only 1 Juggernaut Key Mind may be taken per army.</description></rule></rules><infoLinks><infoLink id="bd4d-eaf8-4429-07ac" name="Platoon Commander" hidden="false" targetId="d64b-7cdb-29ec-6b71" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="50.0"/></costs></selectionEntry><selectionEntry id="adbc-7495-454f-96cd" name="Command Vehicle" hidden="false" collective="false" import="true" type="upgrade"><comment>Designate this vehicle as a Command Vehicle (+10 pts). Not allowed on a Juggernaut Key Mind.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2aa3-da3a-eb9a-71e3"/></constraints><infoLinks><infoLink id="3661-a7ab-5ff4-ce01" name="Command Vehicle" hidden="false" targetId="6768-ad5e-d28b-8396" type="rule"/></infoLinks><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="9ec2-33c2-b65e-c5b1" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="823a-2d4c-1faf-e7ae"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="269c-b0cb