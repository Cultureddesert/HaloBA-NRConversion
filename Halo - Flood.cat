</constraints><costs><cost name="pts" typeId="points" value="41.0"/></costs></selectionEntry><selectionEntry id="5337-5db2-ab77-5629" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d3ca-d813-09e6-1c81"/></constraints><costs><cost name="pts" typeId="points" value="55.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="84ab-4a8a-fb7d-1a4a" name="Juggernaut" hidden="false" collective="false" import="true" type="unit"><profiles><profile id="52d1-d94c-783c-9955" name="Juggernaut" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Walker</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">7+ (Light Walker)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile></profiles><rules><rule id="c0de-9086-ca16-1b8e" name="Synaptic Relay" hidden="false"><description>If at least one Flood Officer is alive, this unit extends that officer’s command bubble to Flood Infantry and Artillery within 6&quot; of it, but with the morale bonus halved. For normal morale checks, affected units use the highest officer’s morale bonus available (halved). For Snap To via this relay, only the activating officer’s halved morale bonus is used, even if another officer on the field has a higher bonus.</description></rule></rules><infoLinks><infoLink id="6766-8283-0feb-78fd" name="Forward-facing Tentacle Lash" hidden="false" targetId="d5d5-b68e-1ba0-b003" type="profile"/><infoLink id="0fb5-5ed4-b2b9-863c" name="Shaped Charge" hidden="false" targetId="9ede-218d-bbb4-33a1" type="rule"/><infoLink id="d68d-48c3-412e-0999" name="Fist" hidden="false" targ