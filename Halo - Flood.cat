den="false" targetId="d8bd-d5f7-b64f-4963" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="afdf-3323-3a5b-a034" name="Command Vehicle" hidden="false" collective="false" import="true" type="upgrade"><comment>Designate this vehicle as a Command Vehicle (+10 pts). Not allowed on a Juggernaut Key Mind.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7b20-3d19-ccec-3219"/></constraints><infoLinks><infoLink id="d105-bbcf-b97f-9257" name="Command Vehicle" hidden="false" targetId="6768-ad5e-d28b-8396" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="d785-f984-2a74-acb9" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="f23a-020a-577a-0418"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="360e-3f23-f2dc-87d3"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a94e-2e2b-8168-88bf"/></constraints><selectionEntries><selectionEntry id="f23a-020a-577a-0418" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="30f7-fd8c-fe4c-5717"/></constraints><costs><cost name="pts" typeId="points" value="200.0"/></costs></selectionEntry><selectionEntry id="854f-8366-9200-acba" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4769-f947-3dbf-fc0a"/></constraints><costs><cost name="pts" typeId="points" value="240.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="3429-571c-254e-b9ae" name="Bomber Form" hidden="false" collective="false" import="true" type="unit"><constraints><constraint type="max" value="2" field="selections" scope="force" shared="true" id="56fd-3732-a622-9d74" includeChildSelections="false" includeChildForces="false"/></constraints><profiles><profile id="946f-a01c-b530-6d58" name="Bomber Form" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Aircraft</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">7+ (Medium Aircraft)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">20</characteristic></characteristics></profile></profiles><rules><rule id="e3fc-2837-c660-d08d" name="Reinforcement Drop" hidden="false"><description>After this vehicle completes an Advance or Run move, choose one friendly Infection Form Swarm that this unit moved over during that move. Return D3 previously removed Infection Forms to that unit, up to the number of models that unit began the game with.</description></rule><rule id="996b-acfc-daa3-7a8e" name="Airborne Carrier Form" hidden="false"><description>This vehicle may only transport models belonging to Infection Form Swarms. It cannot transport any other units.</description></rule><rule id="13de-c298-0069-ca7d" name="Aerial Dispersal" hidden="false"><description>While this Aircraft is Flying, embarked Infection Form Swarms may disembark normally, ignoring the usual restriction that prevents them from disembarking from a Flying Aircraft.</description></rule><rule id="028d-ba6d-336c-0dec" name="Buoyant Form" hidden="false"><description>This Aircraft may move a maximum of 12&quot; with an Advance order or 24&quot; with a Run order.</description></rule><rule id="d700-03fb-5b37-0bdc" name="Limited" hidden="false"><description>Only 2 Bomber Forms may be taken per army.</description></rule></rules><infoLinks><infoLink id="e0c3-19a9-926a-b6ca" name="Unarmed" hidden="false" targetId="2104-2b5b-3e34-17db" type="profile"/><infoLink id="0325-16e4-94db-e291" name="Open-topped" hidden="false" targetId="9f53-15e2-e2eb-9ee8" type="rule"/></infoLinks><categoryLinks><categoryLink id="41d5-fbbc-a804-4378" name="Aircraft" hidden="false" targetId="9cd4-4d03-18e5-5c89" primary="true"/><categoryLink id="670d-6a28-1f83-09ca" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="600f-7910-fa5d-30f5" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="c9c3-ff0d-9be1-048f"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="5bd6-4f76-57ce-5615"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="be0e-a9ce-950c-adfd"/></constraints><selectionEntries><selectionEntry id="c9c3-ff0d-9be1-048f" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="86fc-55ca-9ddf-bac1"/></constraints><costs><cost name="pts" typeId="points" value="65.0"/></costs></selectionEntry><selectionEntry id="62c9-3f57-db7a-8433" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="92a5-005c-a42d-0e2e"/></constraints><costs><cost name="pts" typeId="points" value="78.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="4337-960e-8a73-4eb7" name="The Gravemind" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: The Gravemind requires a Flood Company Commander. The Gravemind requires at least 2 units chosen from Tank Form Pack, Spawner Form, or Stalker Form Swarm.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0840-1b62-b2f0-a322"/></constraints><rules><rule id="8798-0269-09dd-0532" name="Coordinated Infestation" hidden="false"><description>Friendly Flood Officers double the range of their Morale bonus and You men, snap to action! ability when affecting friendly Flood Infantry or Artillery units.

A Flood Platoon Commander therefore has a 12&quot; Morale bonus range and a 12&quot; range for You men, snap to action!.

A Flood Company Commander therefore has a 24&quot; Morale bonus range and a 24&quot; range for You men, snap to action!.</description></rule></rules><categoryLinks><categoryLink id="92f8-28f1-2ab9-3f7a" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="b76c-ea0a-490c-e819" name="Leader: The Gravemind" hidden="false" targetId="4c86-338f-0000-8789" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="55.0"/></costs></selectionEntry><selectionEntry id="2b7d-d9ca-9e6a-ab24" name="Feral Outbreak" hidden="false" collective="false" import="true" type="upgrade"><comment>Requirements: Feral Outbreak cannot include a Flood Company Commander. Feral Outbreak may not include Stalker Form Swarm, Tank Form Pack, Spawner Form, Juggernaut, or Abomination. Current forbidden units: ?</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f380-ea91-af51-4739"/></constraints><rules><rule id="9af2-5278-32d0-7785" name="Ravenous Surge" hidden="false"><description>Once per game, at the beginning of a turn before any Order Dice are drawn, choose any number of friendly Flood Infantry units that do not already have an Order Die assigned. For each chosen unit, take one of your Order Dice from the bag and assign it to that unit as a Run order one by one.

Chosen units do not take Order tests and do not remove Pins. Each unit must move as directly as possible toward the closest enemy Infantry or Artillery unit. If that enemy is within assault range and line of sight, the Flood unit must assault it instead.

If several eligible enemy units are equally close, or it is not clear which is closest, the opposing player chooses the target. Units activated this way count as activated for the turn.</description></rule></rules><categoryLinks><categoryLink id="a90b-43ca-6826-b72f" name="Army Leader" hidden="false" targetId="5f79-a9ac-d0a1-d88e" primary="true"/><categoryLink id="f425-aede-f696-746c" name="Leader: Feral Outbreak" hidden="false" targetId="71eb-10d0-8e93-7505" primary="false"/></categoryLinks><costs><cost name="pts" typeId="points" value="75.0"/></costs></selectionEntry></selectionEntries></catalogue>
