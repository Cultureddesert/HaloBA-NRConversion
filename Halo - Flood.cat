false"><description>If the Scorpion is targeted by any attack (regardless of weapon type), any infantry riding as passengers must immediately disembark before any dice are rolled. The attacker must be in range of the tank. Disembarking units are immediately placed within 1&quot; of the vehicle and automatically count as having gone Down or remain Down if already Down.</description></rule><rule id="23a1-044e-1490-a3b7" name="Improved HE" hidden="false"><description>Instead of HE (1&quot;), the Medium Anti-Tank Weapon has HE (2&quot;).</description></rule></rules><infoLinks><infoLink id="798a-42ba-d736-2080" name="Team" hidden="false" targetId="6f66-da7c-bbd4-6256" type="rule"/><infoLink id="5396-afba-68e5-98f8" name="Fixed" hidden="false" targetId="b59b-2104-403e-f4a6" type="rule"/><infoLink id="b484-caac-5a6c-7317" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/><infoLink id="7413-1822-e83c-9db5" name="AT Gun" hidden="false" targetId="c079-b951-5547-15db" type="rule"/></infoLinks><modifiers><modifier type="add" field="category" value="402e-4af1-db7f-959e"><conditions><condition type="atLeast" value="1" field="selections" scope="7b11-62b3-2031-2b66" childId="8d76-3075-7ba5-2f22" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="8048-9d45-bbed-168e" name="Tanks &amp; Tank Destroyers" hidden="false" targetId="eaf2-7106-a937-484b" primary="true"/><categoryLink id="eaad-7457-2ffa-03a4" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="5ba0-2778-e4d9-0df9" name="Pintle-mounted MMG (forward arc)" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="12b4-8d52-6365-54bd"/></constraints><profiles><profile id="8a62-f390-432b-2d4f" name="Pintle-mounted MMG (forward arc)" hid