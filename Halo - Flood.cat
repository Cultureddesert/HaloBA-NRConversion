 id="0944-6042-ab51-e099" name="Wide Formation" hidden="false" targetId="ddd5-7152-2e25-0414" type="rule"/><infoLink id="e5d6-cf13-6a73-54b0" name="Behind Enemy Lines" hidden="false" targetId="a7bd-6f9a-4bec-fd25" type="rule"/></infoLinks><modifiers><modifier type="increment" field="2e04-2a4c-0a38-5a28" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="force" childId="de03-be30-08bc-3183" shared="true" roundUp="false" includeChildSelections="false" includeChildForces="false"/></repeats></modifier><modifier type="set" field="2e04-2a4c-0a38-5a28" value="-1"><conditions><condition type="lessThan" value="1" field="selections" scope="force" childId="de03-be30-08bc-3183" shared="true" includeChildSelections="false" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="0b7c-73ee-192b-4a5f" name="Infantry" hidden="false" targetId="df70-8f8e-7691-78d3" primary="true"/><categoryLink id="6c52-b3b0-7019-524b" name="Rifle Platoon Infantry" hidden="false" targetId="5849-8392-0f7a-fe48" primary="false"/><categoryLink id="78ae-5a2c-fc5c-0b5b" name="Transport Allowance Unit" hidden="false" targetId="c868-ee48-0704-5a98" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="794b-5507-b1db-03d7" name="Additional Models" hidden="false" collective="false" import="true" type="upgrade"><comment>Add up to 5 extra models (unit starts with 5, max 10).</comment><constraints><constraint type="max" value="5" field="selections" scope="parent" shared="true" id="7445-ed97-eb36-4d80"/></constraints><modifiers><modifier type="set" field="points" value="13"><conditions><condition type="atLeast" value="1" field="selections" scope="dc27-6308-273d-8171" childId="726d-f6b3-97db-a1c7" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry><selectionEntry id="51a1-f4e1-3897-980b" name="Spore Cloud" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. 1 pts per model.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a680-b254-23f7-127b"/></constraints><infoLinks><infoLink id="9512-dcc4-f184-91dc" name="Spore Cloud" hidden="false" targetId="81ef-2e27-9c66-b379" type="rule"/></infoLinks><modifiers><modifier type="increment" field="points" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="dc27-6308-273d-8171" childId="794b-5507-b1db-03d7" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier></modifiers><costs><cost name="pts" typeId="points" value="5.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="ffe7-6c3f-5dbc-128e" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="726d-f6b3-97db-a1c7"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="8c08-762c-9cf9-16a9"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a511-05f4-2351-1c82"/></constraints><selectionEntries><selectionEntry id="0ea4-2233-acf5-20b8" name="Inexperienced" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="58e5-0c80-9809-1818"/></constraints><costs><cost name="pts" typeId="points" value="50.0"/></costs></selectionEntry><selectionEntry id="726d-f6b3-97db-a1c7" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="21e6-65fd-b6ff-323c"/></constraints><costs><cost name="pts" typeId="points" value="65.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="be35-4f7d-b23e-1232" name="Carrier Form Team" hidden="false" collective="false" import="true" type="unit"><profiles><profile id="e02c-1e3b-8ea1-9e5a" name="Carrier Form Team" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Team</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">–</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile></profiles><rules><rule id="1df5-4aac-4fc3-1fff" name="Suicide Charge" hidden="false"><description>If this model successfully assaults an enemy unit, it is immediately destroyed, and Explosive Biomass takes effect. Additionally, while this unit is on Ambush, if an enemy Infantry or Artillery unit ends a movement within 6&quot; and line of sight of it, instead of firing, you may immediately flip its Ambush order to Run and declare an assault against that enemy unit before it has a chance to fire.</description></rule><rule id="7352-ec17-24d8-404f" name="Explosive Biomass" hidden="false"><description>If this model is destroyed, the enemy unit it is fighting in close quarters suffers a HE (1&quot;) hit. Being Down does not halve hits for this attack.</description></rule><rule id="d821-00bb-d5b8-9040" name="Spawn Infection Forms" hidden="false"><description>When this unit is destroyed, immediately replace the model with a 3 model Inexperienced Infection Forms unit. Place them as close as possible to the position where the Carrier Form was destroyed, while remaining at least 1&quot; away from any other units. These Infection Forms lose all pins and use the same Order Die the Carrier Form unit had. If there is not enough space to place them all, place as many as possible. For scoring purposes, the Carrier Form and any Infection Forms spawned by this rule count as a single unit.</description></rule></rules><infoLinks><infoLink id="5d18-5217-2b94-c247" name="Explosive Biomass" hidden="false" targetId="5502-3c2c-bc04-c870" type="profile"/><infoLink id="5730-ecce-fb85-e2ce" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/><infoLink id="4953-7305-b581-be32" name="Tank Hunters" hidden="false" targetId="94e0-aa25-ea6d-2b93" type="rule"/><infoLink id="fd03-0da8-acac-924b" name="Infiltrator" hidden="false" targetId="c4aa-6536-5471-bd48" type="rule"/><infoLink id="1ac6-f820-69c6-3e24" name="Horror" hidden="false" targetId="8d17-f961-100c-1c5d" type="rule"/></infoLinks><categoryLinks><categoryLink id="c945-c0da-46b7-ab79" name="Teams &amp; Artillery" hidden="false" targetId="a565-b680-54d0-c12b" primary="true"/><categoryLink id="65c4-dfca-3ece-1223" name="Transport Allowance Unit" hidden="false" targetId="c868-ee48-0704-5a98" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="3ca4-ccb7-3ad0-5415" name="Patient Predators" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="454c-ea8a-dc7b-09ee"/></constraints><infoLinks><infoLink id="a4be-fdc3-a8f9-a6cf" name="Patient Predators" hidden="false" targetId="5202-2062-66fb-94e2" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="1.0"/></costs></selectionEntry><selectionEntry id="be32-c005-68d9-b020" name="Volatile Biomass" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. Flat 5 pts. Replaces the Explosive Biomass weapon profile and rule (HE 1&quot; becomes HE 2&quot;) and the Suicide Charge text. If taken, use these in place of the base versions.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a48c-d429-4fd6-2bfd"/></constraints><rules><rule id="34a7-6091-216a-9f2b" name="Volatile Biomass" hidden="false"><description>If this model is destroyed, the enemy unit it is fighting in close quarters suffers a HE (2&quot;) hit. Being Down does not halve hits for this attack.</description></rule><rule id="52d5-b10b-fd02-e4a7" name="Suicide Charge" hidden="false"><description>If this model successfully assaults an enemy unit, it is immediately destroyed, and Volatile Biomass takes effect. Additionally, while this unit is on Ambush, if an enemy Infantry or Artillery unit ends a movement within 6&quot; and line of sight of it, instead of firing, you may immediately flip its Ambush order to Run and declare an assault against that enemy unit before it has a chance to fire.</description></rule></rules><infoLinks><infoLink id="383c-0ace-feb7-e9f3" name="Volatile Biomass" hidden="false" targetId="4968-12e5-1f38-d7ee" type="profile"/></infoLinks><costs><cost name="pts" typeId="points" value="5.0"/></costs></selectionEntry><selectionEntry id="fd64-d39f-6af2-91c8" name="Spore Cloud" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. 1 pts per model.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ca01-0a81-05c6-5f85"/></constraints><infoLinks><infoLink id="a46f-1f5c-e569-3abc" name="Spore Cloud" hidden="false" targetId="81ef-2e27-9c66-b379" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="1.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="c2b6-0dee-3847-9dc4" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="d693-b93d-2ed4-9cb2"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="90c2-4f80-074e-ec6c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="01fb-1d12-66dc-01fa"/></constraints><selectionEntries><selectionEntry id="450b-d64b-f439-6db5" name="Inexperienced" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" v