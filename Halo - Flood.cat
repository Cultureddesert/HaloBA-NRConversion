name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">60&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">1</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">+5</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Team, Fixed, HE (1&quot;), AT Gun</characteristic></characteristics></profile><profile id="8271-3d12-8b7f-3ea6" name="Pintle-mounted MMG (forward arc)" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><modifiers><modifier type="increment" field="1c44-f79c-f5d5-65a2" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="7b11-62b3-2031-2b66" childId="5ba0-2778-e4d9-0df9" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="7b11-62b3-2031-2b66" childId="5ba0-2778-e4d9-0df9" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">0</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">36&quot;</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">6</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">–</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Team, Fixed</characteristic></characteristics></profile><profile id="f6ec-db39-c840-573e" name="Coaxial MMG" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><modifiers><modifier type="increment" field="1c44-f79c-f5d5-65a2" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="7b11-62b3-2031-2b66" childId="7d49-4fb2-2f77-d3d7" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></r