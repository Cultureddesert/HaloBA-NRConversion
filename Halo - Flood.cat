3b">10–20</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">–</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile></profiles><rules><rule id="2994-34f5-4774-a1be" name="Assimilate" hidden="false"><description>If this unit wins an assault against a target affected by Flood Infection, compare the target’s number of models at the start of the combat to the number of surviving Infection Forms. If the target began with at least half as many models (rounding down), you may replace each surviving Infection Form with an unarmed Combat Form. The unit immediately becomes Regular, uses the Combat Form rules instead, and retains its current Order Die.</description></rule><rule id="793c-ab29-bd10-0548" name="Mindless Hunger" hidden="false"><description>This unit cannot pick up, carry, score or control objectives. It may still contest objectives.</description></rule></rules><infoLinks><infoLink id="f322-1054-0281-eb3c" name="Unarmed" hidden="false" targetId="2104-2b5b-3e34-17db" type="profile"/><infoLink id="71cb-1641-2f01-33f2" name="Horror" hidden="false" targetId="8d17-f961-100c-1c5d" type="rule"/><infoLink id="1644-e490-b04e-64b7" name="Fieldcraft" hidden="false" targetId="7589-197f-fba6-ec18" type="rule"/><infoLink id="3313-6388-bd58-0b6c" name="Behind Enemy Lines" hidden="false" targetId="a7bd-6f9a-4bec-fd25" type="rule"/></infoLinks><categoryLinks><categoryLink id="a00e-1f12-992e-a560" name="Infantry" hidden="false" targetId="df70-8f8e-7691-78d3" primary="true"/><categoryLink id="d695-e025-6a7b-498f" name="Rifle Platoon Infantry" hidden="false" targetId="5849-8392-0f7a-fe48" primary="false"/><categoryLink id="515f-c672-5193-9801" name="Transport Allowance Unit" hidden="false" targetId="c868-ee48-0704-5a98" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="9437-9c46-35ca-aa53" name="Additional Models" hidden="false" collective="false" import="true" type="upgrade"><comment>Add up to 10 extra models (unit starts with 10, max 20).</comment><constraints><constraint type="max" value="10" field="selections" scope="parent" shared="true" id="4f2b-8884-d8db-2cfa"/></constraints><costs><cost name="pts" typeId="points" value="6.0"/></costs></selectionEntry><selectionEntry id="b796-2d6b-21d5-b0cb" name="Flood Burster" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="02e3-26a3-85a0-4e64"/></constraints><infoLinks><infoLink id="c45f-a936-59d6-be52" name="Flood Burster" hidden="false" targetId="52d0-d1fe-926f-de73" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="1.0"/></costs></selectionEntry><selectionEntry id="6751-aa88-73f7-0d3d" name="Spore Cloud" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. 1 pts per model.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b27e-69ab-8d31-e476"/></constraints><infoLinks><infoLink id="1a5c-d406-2904-69c4" name="Spore Cloud" hidden="false" targetId="81ef-2e27-9c66-b379" type="rule"/></infoLinks><modifiers><modifier type="increment" field="points" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="fee3-a855-f139-e83e" childId="9437-9c46-35ca-aa53" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier></modifiers><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="85aa-95e6-f5af-ffed" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="bd40-4494-3fc9-7a67"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="f221-77f4-9b1a-3aeb"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3