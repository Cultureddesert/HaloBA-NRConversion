tions></modifier><modifier type="set" field="f2ee-ef5c-ac2f-0a29" value="5+"><conditions><condition type="atLeast" value="1" field="selections" scope="be35-4f7d-b23e-1232" childId="e47e-e9b0-f044-e17f" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Team</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">4+</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile><profile id="f099-e11f-8e77-62eb" name="Explosive Biomass" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><modifiers><modifier type="decrement" field="1c44-f79c-f5d5-65a2" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="be35-4f7d-b23e-1232" childId="be32-c005-68d9-b020" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="be35-4f7d-b23e-1232" childId="be32-c005-68d9-b020" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">–</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">–</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">HE</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Suicide Charge, HE (1&quot;)</characteristic></characteristics></profile><profile id="8b8e-342a-d45d-857c" name="Volatile Biomass" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><modifiers><modifier type="increment" field="1c44-f79c-f5d5-65a2" value="1"><repeats><repeat value="1" repeats="1" field="selections" scope="be35-4f7d-b23e-1232" childId="be32-c005-68d9-b020" shared="true" roundUp="false" includeChildSelections="true" includeChildForces="false"/></repeats></modifier><modifier type="set" field="hidden" value="true"><conditions><condition type="lessThan" value="1" field="selections" scope="be35-4f7d-b23e-1232" childId="be32-c005-68d9-b020" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">0</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">–</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">–</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">HE</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">Suicide Charge, HE (2&quot;)</characteristic></characteristics></profile></profiles><rules><rule id="1df5-4aac-4fc3-1fff" name="Suicide Charge" hidden="false"><description>If this model successfully assaults an enemy unit, it is immediately destroyed, and Explosive Biomass takes effect. Additionally, while this unit is on Ambush, if an enemy Infantry or Artillery unit ends a movement within 6&quot; and line of sight of it, instead of firing, you may immediately flip its Ambush order to Run and declare an assault against that enemy unit before it has a chance to fire.</description></rule><rule id="7352-ec17-24d8-404f" name="Explosive Biomass" hidden="false"><description>If this model is destroyed, the enemy unit it is fighting in close quarters suffers a HE (1&quot;) hit. Being Down does not halve hits for this attack.</description></rule><rule id="d821-00bb-d5b8-9040" name="Spawn Infection Forms" hidden="false"><description>When this unit is destroyed, immediately replace the model with a 3 model Inexperienced Infection Forms unit. Place them as close as possible to the position where the Carrier Form was destroyed, while remaining at least 1&quot; away from any other units. These Infection Forms lose all pins and use the same Order Die the Carrier Form unit had. If there is not enough space to place them all, place as many as possible. For scoring purposes, the Carrier Form and any Infection Forms spawned by this rule count as a single unit.</description></rule></rules><infoLinks><infoLink id="4953-7305-b581-be32" name="Tank Hunters" hidden="false" targetId="94e0-aa25-ea6d-2b93" type="rule"/><infoLink id="fd03-0da8-acac-924b" name="Infiltrator" hidden="false" targetId="c4aa-6536-5471-bd48" type="rule"/><infoLink id="1ac6-f820-69c6-3e24" name="Horror" hidden="false" targetId="8d17-f961-100c-1c5d" type="rule"/><infoLink id="5730-ecce-fb85-e2ce" name="HE" hidden="false" targetId="c659-80b2-bebe-eb79" type="rule"/></infoLinks><categoryLinks><categoryLink id="c945-c0da-46b7-ab79" name="Teams &amp; Artillery" hidden="false" targetId="a565-b680-54d0-c12b" primary="true"/><categoryLink id="65c4-dfca-3ece-1223" name="Transport Allowance Unit" hidden="false" targetId="c868-ee48-0704-5a98" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="c2b6-0dee-3847-9dc4" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="d693-b93d-2ed4-9cb2"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="90c2-4f80-074e-ec6c"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="01fb-1d12-66dc-01fa"/></constraints><selectionEntries><selectionEntry id="450b-d64b-f439-6db5" name="Inexperienced" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="47ef-6f4b-962f-f522"/></constraints><costs><cost name="pts" typeId="points" value="14.0"/></costs></selectionEntry><selectionEntry id="d693-b93d-2ed4-9cb2" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3fcc-8cf5-0025-2a7c"/></constraints><costs><cost name="pts" typeId="points" value="20.0"/></costs></selectionEntry><selectionEntry id="e47e-e9b0-f044-e17f" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="816b-2168-8982-8c46"/></constraints><costs><cost name="pts" typeId="points" value="26.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="1ec1-f844-b118-bf5b" name="Squad Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="3ca4-ccb7-3ad0-5415" name="Patient Predators" hidden="false" collective="false" import="true" type="upgrade"><comment>Costs 1 pts per model.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="454c-ea8a-dc7b-09ee"/></constraints><infoLinks><infoLink id="a4be-fdc3-a8f9-a6cf" name="Patient Predators" hidden="false" targetId="5202-2062-66fb-94e2" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="1.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="ea67-4f09-2fc5-cb7d" name="Armoury" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="be32-c005-68d9-b020" name="Volatile Biomass" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. Flat 5 pts. Replaces the Explosive Biomass weapon with Volatile Biomass (HE 1&quot; becomes HE 2&quot;) and updates the Suicide Charge text. If taken, use these rules in place of the base versions.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a48c-d429-4fd6-2bfd"/></constraints><rules><rule id="34a7-6091-216a-9f2b" name="Volatile Biomass" hidden="false"><description>If this model is destroyed, the enemy unit it is fighting in close quarters suffers a HE (2&quot;) hit. Being Down does not halve hits for this attack.</description></rule><rule id="52d5-b10b-fd02-e4a7" name="Suicide Charge" hidden="false"><description>If this model successfully assaults an enemy unit, it is immediately destroyed, and Volatile Biomass takes effect. Additionally, while this unit is on Ambush, if an enemy Infantry or Artillery unit ends a movement within 6&quot; and line of sight of it, instead of firing, you may immediately flip its Ambush order to Run and declare an assault against that enemy unit before it has a chance to fire.</description></rule></rules><costs><cost name="pts" typeId="points" value="5.0"/></costs></selectionEntry><selectionEntry id="fd64-d39f-6af2-91c8" name="Spore Cloud" hidden="false" collective="false" import="true" type="upgrade"><comment>Armoury item. 1 pts per model.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ca01-0a81-05c6-5f85"/></constraints><infoLinks><infoLink id="a46f-1f5c-e569-3abc" name="Spore Cloud" hidden="false" targetId="81ef-2e27-9c66-b379" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="1.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="2dd4-526b-d2aa-8925" name="Spawner Form" hidden="false" collective="false" import="true" type="unit"><constraints><constraint type="max" value="0" field="selections" scope="force" shared="true" id="1b7d-c7ea-8a19-9ac8" includeChildSelections="false" includeChildForces="false"/></constraints><profiles><profile id="ba5d-e71d-f4ab-85ca" name="Spawner Form" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Infantry</characteristic><characteristic name="Models" typeId="c1