itionGroups></modifier><modifier type="add" field="category" value="fc3d-0c75-8e93-03e0"><conditions><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="cd8d-dd9b-5737-d3a7" name="Walkers" hidden="false" targetId="1d11-002e-4141-d18a" primary="true"/><categoryLink id="381f-27d0-3289-a910" name="Unit Barred by Feral Outbreak" hidden="false" targetId="d8bd-d5f7-b64f-4963" primary="false"/></categoryLinks><selectionEntries><selectionEntry id="651a-4c83-f9cb-88c3" name="Juggernaut Key Mind" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b8d1-b23f-840e-d07b"/></constraints><rules><rule id="bf3b-2516-41de-cead" name="Juggernaut Key Mind" hidden="false"><description>A Juggernaut Key Mind gains the Platoon Commander special rule and fills one Platoon Commander slot in a platoon. For all other purposes, it remains a Walker. However, it does not count towards an Armoured Platoon’s composition, vehicle limits, or vehicle requirements, and is ignored when determining any other force-organisation requirements or limits based on vehicles. A Juggernaut Key Mind cannot also be a Command Vehicle.</description></rule><rule id="7da9-207b-46bb-b3a6" name="Limited" hidden="false"><description>Only 1 Juggernaut Key Mind may be taken per army.</description></rule></rules><infoLinks><infoLink id="bd4d-eaf8-4429-07ac" name="Platoon Commander" hidden="false" targetId="d64b-7cdb-29ec-6b71" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="50.0"/></costs></selectionEntry><selectionEntry id="adbc-7495-454f-96cd" name="Command Vehicle" hidden="false" collective="false" import="true" type="upgrade"><comment>Designate this vehicle as a Command Vehicle (+10 pts). Not allowed on a Juggernaut Key Mind.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2aa3-da3a-eb9a-71e3"/></constraints><infoLinks><infoLink id="3661-a7ab-5ff4-ce01" name="Command Vehicle" hidden="false" targetId="6768-ad5e-d28b-8396" type="rule"/></infoLinks><modifiers><modifier type="set" field="hidden" value="true"><conditions><condition type="atLeast" value="1" field="selections" scope="84ab-4a8a-fb7d-1a4a" childId="651a-4c83-f9cb-88c3" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries><selectionEntryGroups><selectionEntryGroup id="9ec2-33c2-b65e-c5b1" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="823a-2d4c-1faf-e7ae"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="269c-b0cb-2cd8-5f43"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1fe5-c60c-0ccb-f372"/></constraints><selectionEntries><selectionEntry id="823a-2d4c-1faf-e7ae" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e8cc-ee8c-9ad9-3a96"/></constraints><costs><cost name="pts" typeId="points" value="95.0"/></costs></selectionEntry><selectionEntry id="71b7-a8df-32b2-0de5" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4565-19ff-71fa-723f"/></constraints><costs><cost name="pts" typeId="points" value="114.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="c995-a216-33cd-b8e9" name="Thrasher" hidden="false" collective="false" import="true" ty