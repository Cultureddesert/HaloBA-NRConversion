ared="true" id="dc81-59b4-226b-8ba3"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="9df0-cf5b-fcbb-2f47"/></constraints><selectionEntries><selectionEntry id="417c-f9a6-f099-3100" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="38ee-102b-90ec-1761"/></constraints><costs><cost name="pts" typeId="points" value="52.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="fee3-a855-f139-e83e" name="Infection Form Swarm" hidden="false" collective="false" import="true" type="unit"><profiles><profile id="3692-79aa-9e62-5446" name="Infection Form Swarm" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Infantry</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">10–20</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">–</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">–</characteristic></characteristics></profile></profiles><rules><rule id="2994-34f5-4774-a1be" name="Assimilate" hidden="false"><description>If this unit wins an assault against a target affected by Flood Infection, compare the target’s number of models at the start of the combat to the number of surviving Infection Forms. If the target began with at least half as many models (rounding down), you may replace each surviving Infection Form with an unarmed Combat Form. The unit immediately becomes Regular, uses the Combat Form rules instead, and retains its current Order Die.</description></rule><rule id="793c-ab29-bd10-0548" name="Mindless Hunger" hidden="false"><description>This unit cannot pick up, carry, score or control objectives. It may still contest objectives.</description></rule></rules><infoLinks><infoLin