nk id="08e5-c511-fd3c-8b0d" name="Slower" hidden="false" targetId="3475-b3f7-37bc-ef72" type="rule"/><infoLink id="a638-143c-263d-ea5e" name="Shaped Charge" hidden="false" targetId="9ede-218d-bbb4-33a1" type="rule"/></infoLinks><modifiers><modifier type="add" field="category" value="402e-4af1-db7f-959e"><conditions><condition type="atLeast" value="1" field="selections" scope="ef5d-70a2-952c-0809" childId="afdf-3323-3a5b-a034" shared="true" includeChildSelections="true" includeChildForces="false"/></conditions></modifier></modifiers><categoryLinks><categoryLink id="7893-7036-eff5-832c" name="Walkers" hidden="false" targetId="1d11-002e-4141-d18a" primary="true"/><categoryLink id="d545-e4f9-8832-e5a8" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/><categoryLink id="aab8-f88a-7358-b77f" name="Unit Barred by Feral Outbreak" hidden="false" targetId="d8bd-d5f7-b64f-4963" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="d785-f984-2a74-acb9" name="Veterancy" hidden="false" collective="false" import="true" defaultSelectionEntryId="f23a-020a-577a-0418"><constraints><constraint type="min" value="1" field="selections" scope="parent" shared="true" id="360e-3f23-f2dc-87d3"/><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a94e-2e2b-8168-88bf"/></constraints><selectionEntries><selectionEntry id="f23a-020a-577a-0418" name="Regular" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="30f7-fd8c-fe4c-5717"/></constraints><costs><cost name="pts" typeId="points" value="200.0"/></costs></selectionEntry><selectionEntry id="854f-8366-9200-acba" name="Veteran" hidden="false" collective="false" import="true" type="upgrade"><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4769-f947-3dbf-fc0a"/></constraints><costs><cost name="pts" typeId="points" value="240.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup><selectionEntryGroup id="20ad-9350-9f9b-d14b" name="Vehicle Upgrades" hidden="false" collective="false" import="true"><selectionEntries><selectionEntry id="afdf-3323-3a5b-a034" name="Command Vehicle" hidden="false" collective="false" import="true" type="upgrade"><comment>Designate this vehicle as a Command Vehicle (+10 pts). Not allowed on a Juggernaut Key Mind.</comment><constraints><constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7b20-3d19-ccec-3219"/></constraints><infoLinks><infoLink id="d105-bbcf-b97f-9257" name="Command Vehicle" hidden="false" targetId="6768-ad5e-d28b-8396" type="rule"/></infoLinks><costs><cost name="pts" typeId="points" value="10.0"/></costs></selectionEntry></selectionEntries></selectionEntryGroup></selectionEntryGroups></selectionEntry><selectionEntry id="3429-571c-254e-b9ae" name="Bomber Form" hidden="false" collective="false" import="true" type="unit"><constraints><constraint type="max" value="2" field="selections" scope="force" shared="true" id="56fd-3732-a622-9d74" includeChildSelections="false" includeChildForces="false"/></constraints><profiles><profile id="946f-a01c-b530-6d58" name="Bomber Form" hidden="false" typeId="4f99-c622-96b9-db14" typeName="Unit"><characteristics><characteristic name="Type" typeId="edb9-a03d-e44e-2632">Aircraft</characteristic><characteristic name="Models" typeId="c162-476c-a031-003b">1</characteristic><characteristic name="Damage Value" typeId="f2ee-ef5c-ac2f-0a29">7+ (Medium Aircraft)</characteristic><characteristic name="Transport" typeId="5d1c-b220-d676-62fa">20</characteristic></characteristics></profile><profile id="8554-55d1-7b29-b421" name="Unarmed" hidden="false" typeId="687b-50c6-e68d-9ed8" typeName="Weapon"><characteristics><characteristic name="Qty" typeId="1c44-f79c-f5d5-65a2">1</characteristic><characteristic name="Range" typeId="88e2-96b8-e9cf-cb86">–</characteristic><characteristic name="Shots" typeId="164a-51d2-e474-ab4c">–</characteristic><characteristic name="Pen" typeId="d266-c548-f63b-0ea2">–</characteristic><characteristic name="Special Rules" typeId="0bf8-e72d-45f4-c21d">No ranged weapon</characteristic></characteristics></profile></profiles><rules><rule id="e3fc-2837-c660-d08d" name="Reinforcement Drop" hidden="false"><description>After this vehicle completes an Advance or Run move, choose one friendly Infection Form Swarm that this unit moved over during that move. Return D3 previously removed Infection Forms to that unit, up to the number of models that unit began the game with.</description></rule><rule id="996b-acfc-daa3-7a8e" name="Airborne Carrier Form" hidden="false"><description>This vehicle may only transport models belonging to Infection Form Swarms. It cannot transport any other units.</description></rule><rule id="13de-c298-0069-ca7d" name="Aerial Dispersal" hidden="false"><description>While this Aircraft is Flying, embarked Infection Form Swarms may disembark normally, ignoring the usual restriction that prevents them from disembarking from a Flying Aircraft.</description></rule><rule id="028d-ba6d-336c-0dec" name="Buoyant Form" hidden="false"><description>This Aircraft may move a maximum of 12&quot; with an Advance order or 24&quot; with a Run order.</description></rule><rule id="d700-03fb-5b37-0bdc" name="Limited" hidden="false"><description>Only 2 Bomber Forms may be taken per army.</description></rule></rules><infoLinks><infoLink id="0325-16e4-94db-e291" name="Open-topped" hidden="false" targetId="9f53-15e2-e2eb-9ee8" type="rule"/></infoLinks><categoryLinks><categoryLink id="41d5-fbbc-a804-4378" name="Aircraft" hidden="false" targetId="9cd4-4d03-18e5-5c89" primary="true"/><categoryLink id="670d-6a28-1f83-09ca" name="Combat Vehicle" hidden="false" targetId="325c-588c-4a24-ce36" primary="false"/></categoryLinks><selectionEntryGroups><selectionEntryGroup id="600f-7910-fa5d-30f5" name="Veterancy" hidden="fa